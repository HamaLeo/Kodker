// دۆزینەوەی ژمارە سەرەتاییەکان (Prime numbers)
کار یەکەمە(ن) {
  ئەگەر ن < ٢ { گەڕێنەوە هەڵە }
  بۆ d لە ٢ تا خوارکە(ڕەگ(ن)) {
    ئەگەر ن % d == ٠ { گەڕێنەوە هەڵە }
  }
  گەڕێنەوە ڕاست
}

گۆڕاو ئەنجام = []
بۆ i لە ١ تا ٥٠ {
  ئەگەر یەکەمە(i) { ئەنجام.زیادبکە(i) }
}
چاپ("ژمارە سەرەتاییەکان:", ئەنجام)
