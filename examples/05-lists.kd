// کارکردن لەگەڵ لیست
نەگۆڕ ژمارەکان = [٥، ٣، ٨، ١، ٩، ٢]
چاپ("لیستەکە:", ژمارەکان)
چاپ("درێژی:", ژمارەکان.درێژی)

نەگۆڕ دووقات = ژمارەکان.نەخشە(x => x * ٢)
چاپ("دووقات:", دووقات)

نەگۆڕ گەورەکان = ژمارەکان.پاڵاوتن(x => x > ٤)
چاپ("گەورەتر لە ٤:", گەورەکان)

نەگۆڕ کۆ = ژمارەکان.کۆکردنەوە((a, b) => a + b, ٠)
چاپ("کۆی گشتی:", کۆ)

بۆ هەر ژ لە ژمارەکان.ڕیزبکە((a, b) => a - b) {
  چاپ("-", ژ)
}
