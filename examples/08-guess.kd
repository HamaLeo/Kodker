// کۆمپیوتەر ژمارەیەکی نهێنی دەدۆزێتەوە بە گەڕانی دووانەیی
نەگۆڕ نهێنی = هەڕەمەکی(١, ١٠٠)
چاپ("ژمارە نهێنییەکە لە ١ هەتا ١٠٠ ــە")

گۆڕاو کەم = ١
گۆڕاو زۆر = ١٠٠
گۆڕاو هەوڵ = ٠

هەتا ڕاست {
  هەوڵ++
  نەگۆڕ گریمانە = خوارکە((کەم + زۆر) / ٢)
  ئەگەر گریمانە == نهێنی {
    چاپ("دۆزیمەوە!", گریمانە, "لە", هەوڵ, "هەوڵدا")
    بشکێنە
  } ئەگەرنا ئەگەر گریمانە < نهێنی {
    کەم = گریمانە + ١
  } ئەگەرنا {
    زۆر = گریمانە - ١
  }
}
