// درەخت: کارێک کە خۆی بانگ دەکاتەوە (Recursion)
قەبارە(٤٠٠، ٤٠٠)
پاشبنەمابکە("ئاسمانی")
هێڵڕەنگبکە("قاوەیی")

کار لق(درێژی، ئاست) {
  ئەگەر ئاست == ٠ { گەڕێنەوە }
  ئەستووریبکە(ئاست)
  پێشەوە(درێژی)
  بۆچەپ(٢٥)
  لق(درێژی * ٠٫٧٥، ئاست - ١)
  بۆڕاست(٥٠)
  لق(درێژی * ٠٫٧٥، ئاست - ١)
  بۆچەپ(٢٥)
  دواوە(درێژی)
}

قەڵەمبەرز()
دواوە(١٦٠)
قەڵەمدابنێ()
لق(٨٠، ٨)
