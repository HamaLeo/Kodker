// ئەنیمەیشن: تۆپێک کە لە دیوارەکان دەگەڕێتەوە
قەبارە(٤٠٠، ٢٨٠)
گۆڕاو x = ٥٠
گۆڕاو y = ٥٠
گۆڕاو dx = ٥
گۆڕاو dy = ٣

بۆ t لە ١ تا ٢٠٠ {
  پاشبنەمابکە("ڕەش")
  ڕەنگبکە(پەلکەزێڕینە(t * ٥))
  بازنە(x، y، ٢٠)

  x += dx
  y += dy
  ئەگەر x < ٢٠ یان x > ٣٨٠ { dx = -dx }
  ئەگەر y < ٢٠ یان y > ٢٦٠ { dy = -dy }

  فریم()
}
