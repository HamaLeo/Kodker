// یاری: بگرە! — سەبەتەکە بجووڵێنە بە تیرە چەپ/ڕاست و ئەستێرەکان بگرە
قەبارە(٤٠٠، ٥٠٠)
گۆڕاو سەبەتە = ١٧٠
گۆڕاو ئەستێرەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو ژیان = ٣
گۆڕاو کات = ٠

یاریبکە(() => {
  پاشبنەمابکە("ئاسمانی")
  کات += ١

  // جووڵەی سەبەتە
  ئەگەر کلیل("چەپ") { سەبەتە -= ٧ }
  ئەگەر کلیل("ڕاست") { سەبەتە += ٧ }
  سەبەتە = سنوور(سەبەتە، ٠، ٣٢٠)

  // ئەستێرەی نوێ
  ئەگەر کات % ٣٠ == ٠ {
    ئەستێرەکان.زیادبکە({ x: هەڕەمەکی(٢٠، ٣٨٠)، y: -٢٠، خێرایی: هەڕەمەکی(٣، ٦) })
  }

  بۆ هەر ئ لە ئەستێرەکان {
    ئ.y += ئ.خێرایی
    ڕەنگبکە("زەرد")
    ئەستێرە(ئ.x، ئ.y، ١٦، ٥)
  }

  // گرتن یان لەدەستدان
  گۆڕاو ماونەتەوە = []
  بۆ هەر ئ لە ئەستێرەکان {
    ئەگەر ئ.y > ٤٣٠ و ئ.x > سەبەتە - ١٠ و ئ.x < سەبەتە + ٩٠ {
      خاڵ += ١
    } ئەگەرنا ئەگەر ئ.y > ٥٢٠ {
      ژیان -= ١
    } ئەگەرنا {
      ماونەتەوە.زیادبکە(ئ)
    }
  }
  ئەستێرەکان = ماونەتەوە

  // سەبەتە
  ڕەنگبکە("نارنجی")
  لاکێش(سەبەتە، ٤٥٠، ٨٠، ٣٠)
  ڕەنگبکە("سپی")
  لاکێش(سەبەتە، ٤٤٥، ٨٠، ٨)

  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٥، ٣٥، ٢٤)
  نووسین("ژیان: " + گەورەترین(ژیان، ٠)، ٣٠٠، ٣٥، ٢٤)

  ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٤٠٠، ٥٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! خاڵ: " + خاڵ، ٩٠، ٢٤٠، ٣٠)
    نووسین("کلیک بکە بۆ دووبارە", ٩٥، ٢٨٠، ٢٠)
    ئەگەر کلیککراوە() {
      خاڵ = ٠
      ژیان = ٣
      ئەستێرەکان = []
    }
  }
})
