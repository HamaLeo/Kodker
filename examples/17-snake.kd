// یاری: مار — بە تیرەکان بجووڵێ، سێوەکان بخۆ و بەر دیوار مەکەوە
قەبارە(٤٠٠، ٤٠٠)
نەگۆڕ خانە = ٢٠
نەگۆڕ ژمارە = ٢٠
گۆڕاو مار = [{ x: ١٠، y: ١٠ }، { x: ٩، y: ١٠ }، { x: ٨، y: ١٠ }]
گۆڕاو ئاڕاستە = { x: ١، y: ٠ }
گۆڕاو سێو = { x: ١٥، y: ٥ }
گۆڕاو خاڵ = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو کات = ٠

کار دووبارە() {
  مار = [{ x: ١٠، y: ١٠ }، { x: ٩، y: ١٠ }، { x: ٨، y: ١٠ }]
  ئاڕاستە = { x: ١، y: ٠ }
  خاڵ = ٠
  مردووە = هەڵە
}

یاریبکە(() => {
  // ئاڕاستە (ناتوانێت بە پێچەوانەدا بچێت)
  ئەگەر کلیل("چەپ") و ئاڕاستە.x == ٠ { ئاڕاستە = { x: -١، y: ٠ } }
  ئەگەر کلیل("ڕاست") و ئاڕاستە.x == ٠ { ئاڕاستە = { x: ١، y: ٠ } }
  ئەگەر کلیل("سەرەوە") و ئاڕاستە.y == ٠ { ئاڕاستە = { x: ٠، y: -١ } }
  ئەگەر کلیل("خوارەوە") و ئاڕاستە.y == ٠ { ئاڕاستە = { x: ٠، y: ١ } }

  کات += ١
  ئەگەر کات % ٧ == ٠ و نەک مردووە {
    نەگۆڕ سەر = { x: مار[٠].x + ئاڕاستە.x، y: مار[٠].y + ئاڕاستە.y }
    ئەگەر سەر.x < ٠ یان سەر.y < ٠ یان سەر.x >= ژمارە یان سەر.y >= ژمارە {
      مردووە = ڕاست
    }
    بۆ هەر بەش لە مار {
      ئەگەر بەش.x == سەر.x و بەش.y == سەر.y { مردووە = ڕاست }
    }
    ئەگەر نەک مردووە {
      مار = [سەر، ...مار]
      ئەگەر سەر.x == سێو.x و سەر.y == سێو.y {
        خاڵ += ١
        سێو = { x: هەڕەمەکی(٠، ١٩)، y: هەڕەمەکی(٠، ١٩) }
      } ئەگەرنا {
        مار.لابەرە()
      }
    }
  }

  // کێشان
  پاشبنەمابکە("ڕەش")
  ڕەنگبکە(ڕەنگی(٣٠، ٤٠، ٥٠))
  بۆ i لە ٠ تا ١٩ {
    بۆ j لە ٠ تا ١٩ {
      ئەگەر (i + j) % ٢ == ٠ { لاکێش(i * خانە، j * خانە، خانە، خانە) }
    }
  }
  ڕەنگبکە("سوور")
  بازنە(سێو.x * خانە + ١٠، سێو.y * خانە + ١٠، ٨)
  گۆڕاو n = ٠
  بۆ هەر بەش لە مار {
    ڕەنگبکە(n == ٠ ? "زەرد" : "سەوز")
    لاکێش(بەش.x * خانە + ١، بەش.y * خانە + ١، خانە - ٢، خانە - ٢)
    n += ١
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٦، ٢٠)

  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٤٠٠، ٤٠٠)
    ڕەنگبکە("سپی")
    نووسین("تەواو بوو! خاڵ: " + خاڵ، ١٠٠، ١٩٠، ٣٠)
    نووسین("کلیک بکە بۆ دووبارە", ١٠٥، ٢٣٠، ٢٠)
    ئەگەر کلیککراوە() { دووبارە() }
  }
})
