// یاری: فڵاپی — بۆشایی یان کلیک بۆ باڵ لێدان، لە بۆڕییەکان تێپەڕە
قەبارە(٤٠٠، ٥٠٠)
گۆڕاو y = ٢٥٠
گۆڕاو خێرایی = ٠
گۆڕاو بۆڕییەکان = [{ x: ٤٠٠، بۆشایی: ٢٠٠ }]
گۆڕاو خاڵ = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو کات = ٠
گۆڕاو بەرزترین = ٠

کار دووبارە() {
  y = ٢٥٠
  خێرایی = ٠
  بۆڕییەکان = [{ x: ٤٠٠، بۆشایی: ٢٠٠ }]
  خاڵ = ٠
  مردووە = هەڵە
}

یاریبکە(() => {
  کات += ١
  گۆڕاو باڵ = کلیل("بۆشایی") یان کلیل("سەرەوە") یان ماوسگیراوە()
  ئەگەر باڵ و نەک مردووە { خێرایی = -٦ }
  ئەگەر کلیککراوە() و مردووە { دووبارە() }

  ئەگەر نەک مردووە {
    خێرایی += ٠٫٤
    y += خێرایی
    بۆ هەر ب لە بۆڕییەکان { ب.x -= ٣ }
    ئەگەر بۆڕییەکان[بۆڕییەکان.درێژی - ١].x < ٢١٠ {
      بۆڕییەکان.زیادبکە({ x: ٤٢٠، بۆشایی: هەڕەمەکی(١٢٠، ٣٨٠) })
    }
    ئەگەر بۆڕییەکان[٠].x < -٧٠ {
      بۆڕییەکان.یەکەمیلابەرە()
      خاڵ += ١
      بەرزترین = گەورەترین(بەرزترین، خاڵ)
    }
    بۆ هەر ب لە بۆڕییەکان {
      ئەگەر ٦٠ > ب.x - ١٥ و ٦٠ < ب.x + ٧٠ {
        ئەگەر y < ب.بۆشایی - ٧٠ یان y > ب.بۆشایی + ٧٠ { مردووە = ڕاست }
      }
    }
    ئەگەر y > ٤٨٠ یان y < ٠ { مردووە = ڕاست }
  }

  // ئاسمان
  پاشبنەمابکە("ئاسمانی")
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٨))
  بازنە(((کات * ٠٫٥) % ٥٠٠) - ٥٠، ٨٠، ٣٠)
  بازنە(((کات * ٠٫٥) % ٥٠٠) - ١٨، ٨٨، ٢٤)
  بازنە(((کات * ٠٫٥) % ٥٠٠) - ٧٨، ٨٨، ٢٢)

  // بۆڕییەکان
  بۆ هەر ب لە بۆڕییەکان {
    ڕەنگبکە("سەوز")
    لاکێش(ب.x، ٠، ٧٠، ب.بۆشایی - ٧٠)
    لاکێش(ب.x، ب.بۆشایی + ٧٠، ٧٠، ٥٠٠)
    ڕەنگبکە(ڕەنگی(٠، ١٢٠، ٠))
    لاکێش(ب.x - ٥، ب.بۆشایی - ٩٠، ٨٠، ٢٠)
    لاکێش(ب.x - ٥، ب.بۆشایی + ٧٠، ٨٠، ٢٠)
  }

  // باڵندە
  ڕەنگبکە("زەرد")
  بازنە(٦٠، y، ١٨)
  ڕەنگبکە("سپی")
  بازنە(٦٨، y - ٥، ٦)
  ڕەنگبکە("ڕەش")
  بازنە(٧٠، y - ٥، ٣)
  ڕەنگبکە("نارنجی")
  سێگۆشە(٧٨، y، ٩٢، y + ٤، ٧٨، y + ٨)

  ڕەنگبکە("سپی")
  نووسین(خاڵ، ١٨٠، ٦٠، ٤٨)
  نووسین("باشترین: " + بەرزترین، ١٠، ٢٥، ١٨)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٤٠٠، ٥٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی!", ١٤٠، ٢٣٠، ٤٠)
    نووسین("کلیک بکە بۆ دووبارە", ١١٠، ٢٨٠، ٢٢)
  }
})
