// یاری: بریک‌ئاوت — پاد بە ماوس یان تیرەکان بجووڵێنە و هەموو خشتەکان بشکێنە
قەبارە(٤٨٠، ٤٠٠)
گۆڕاو پاد = ٢٠٠
گۆڕاو x = ٢٤٠
گۆڕاو y = ٣٠٠
گۆڕاو dx = ٣
گۆڕاو dy = -٤
گۆڕاو خشتەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو ژیان = ٣

کار دەستپێک() {
  خشتەکان = []
  بۆ ڕیز لە ٠ تا ٤ {
    بۆ ستوون لە ٠ تا ٨ {
      خشتەکان.زیادبکە({ x: ١٠ + ستوون * ٥١، y: ٥٠ + ڕیز * ٢٦، ڕەنگ: ڕیز * ٣٠ })
    }
  }
}
دەستپێک()

یاریبکە(() => {
  // پاد
  ئەگەر کلیل("چەپ") { پاد -= ٩ }
  ئەگەر کلیل("ڕاست") { پاد += ٩ }
  ئەگەر ماوسX() >= ٠ { پاد = ماوسX() - ٤٥ }
  پاد = سنوور(پاد، ٠، ٣٩٠)

  x += dx
  y += dy
  ئەگەر x < ٨ یان x > ٤٧٢ { dx = -dx }
  ئەگەر y < ٨ { dy = -dy }

  // پاد
  ئەگەر dy > ٠ و y > ٣٥٠ و y < ٣٧٠ و x > پاد و x < پاد + ٩٠ {
    dy = -dy
    dx = (x - (پاد + ٤٥)) / ١٠
  }
  ئەگەر y > ٤١٠ {
    ژیان -= ١
    x = ٢٤٠
    y = ٣٠٠
    dy = -٤
    dx = ٣
  }

  // خشتەکان
  گۆڕاو ماونەتەوە = []
  بۆ هەر ب لە خشتەکان {
    ئەگەر x > ب.x و x < ب.x + ٤٦ و y > ب.y و y < ب.y + ٢٢ {
      dy = -dy
      خاڵ += ١٠
    } ئەگەرنا {
      ماونەتەوە.زیادبکە(ب)
    }
  }
  خشتەکان = ماونەتەوە

  پاشبنەمابکە(ڕەنگی(١٥، ٢٠، ٣٥))
  بۆ هەر ب لە خشتەکان {
    ڕەنگبکە(پەلکەزێڕینە(ب.ڕەنگ))
    لاکێش(ب.x، ب.y، ٤٦، ٢٢)
  }
  ڕەنگبکە("سپی")
  لاکێش(پاد، ٣٦٠، ٩٠، ١٢)
  بازنە(x، y، ٨)
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٤، ٢٠)
  نووسین("ژیان: " + گەورەترین(ژیان، ٠)، ٣٨٠، ٢٤، ٢٠)

  ئەگەر خشتەکان.درێژی == ٠ {
    نووسین("بردتەوە! 🎉", ١٦٠، ٢٠٠، ٣٢)
    ئەگەر کلیککراوە() { خاڵ = ٠؛ ژیان = ٣؛ دەستپێک() }
  } ئەگەرنا ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٤٨٠، ٤٠٠)
    ڕەنگبکە("سپی")
    نووسین("تەواو بوو!", ١٧٠، ٢٠٠، ٣٢)
    ئەگەر کلیککراوە() { خاڵ = ٠؛ ژیان = ٣؛ دەستپێک() }
  }
})
