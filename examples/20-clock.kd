// 🕒 کاتژمێری زیندوو — بە ئێستا() کاتی ڕاستەقینە دەخوێنێتەوە
قەبارە(٤٠٠، ٤٠٠)
نەگۆڕ ن = ٢٠٠

کار دەست(درێژی، ئەستووری، گۆشە، ڕەنگ) {
  هێڵڕەنگبکە(ڕەنگ)
  ئەستووریبکە(ئەستووری)
  نەگۆڕ ڕادیان = (گۆشە - ٩٠) * پای / ١٨٠
  هێڵ(ن، ن، ن + کۆسینۆس(ڕادیان) * درێژی، ن + سینۆس(ڕادیان) * درێژی)
}

یاریبکە(() => {
  نەگۆڕ ک = ئێستا()
  پاشبنەمابکە(ڕەنگی(١٢، ١٨، ٣٢))

  ڕەنگبکە(ڕەنگی(٢٤، ٣٤، ٥٨))
  بازنە(ن، ن، ١٨٠)
  ڕەنگبکە(ڕەنگی(١٢، ١٨، ٣٢))
  بازنە(ن، ن، ١٧٠)

  بۆ i لە ٠ تا ٥٩ {
    نەگۆڕ ڕ = (i * ٦ - ٩٠) * پای / ١٨٠
    نەگۆڕ درێژ = i % ٥ == ٠ ? ١٨ : ٧
    هێڵڕەنگبکە(i % ٥ == ٠ ? "زەرد" : "خۆڵەمێشی")
    ئەستووریبکە(i % ٥ == ٠ ? ٣ : ١)
    هێڵ(ن + کۆسینۆس(ڕ) * ١٦٥، ن + سینۆس(ڕ) * ١٦٥، ن + کۆسینۆس(ڕ) * (١٦٥ - درێژ)، ن + سینۆس(ڕ) * (١٦٥ - درێژ))
  }

  دەست(٩٥، ٩، (ک.سەعات % ١٢ + ک.خولەک / ٦٠) * ٣٠، "سپی")
  دەست(١٣٥، ٦، (ک.خولەک + ک.چرکە / ٦٠) * ٦، "سپی")
  دەست(١٥٠، ٢، ک.چرکە * ٦، "سوور")
  ڕەنگبکە("سوور")
  بازنە(ن، ن، ٩)
  ڕەنگبکە("سپی")
  نووسین(ک.سەعات + ":" + (ک.خولەک < ١٠ ? "٠" : "") + ک.خولەک، ١٧٠، ٢٨٠، ٢٢)
})
