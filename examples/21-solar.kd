// 🪐 سیستەمی خۆر — هەسارەکان بە دەوری خۆردا دەسووڕێنەوە
قەبارە(٥٠٠، ٥٠٠)
گۆڕاو کات = ٠

نەگۆڕ هەسارەکان = [
  { دووری: ٥٠، قەبارە: ٦، خێرایی: ٣، ڕەنگ: "خۆڵەمێشی" },
  { دووری: ٨٠، قەبارە: ١٠، خێرایی: ٢، ڕەنگ: "نارنجی" },
  { دووری: ١١٥، قەبارە: ١١، خێرایی: ١٫٥، ڕەنگ: "شین" },
  { دووری: ١٥٠، قەبارە: ٩، خێرایی: ١٫٢، ڕەنگ: "سوور" },
  { دووری: ١٩٥، قەبارە: ٢٠، خێرایی: ٠٫٧، ڕەنگ: "قاوەیی" },
  { دووری: ٢٣٥، قەبارە: ١٦، خێرایی: ٠٫٥، ڕەنگ: "زەرد" },
]

نەگۆڕ ئەستێرەکان = []
بۆ i لە ١ تا ٩٠ { ئەستێرەکان.زیادبکە({ x: هەڕەمەکی(٠، ٥٠٠)، y: هەڕەمەکی(٠، ٥٠٠)، r: هەڕەمەکی(١، ٢) }) }

یاریبکە(() => {
  کات += ٠٫٦
  پاشبنەمابکە(ڕەنگی(٥، ٥، ١٥))
  ڕەنگبکە("سپی")
  بۆ هەر ئ لە ئەستێرەکان { بازنە(ئ.x، ئ.y، ئ.r) }

  بۆ هەر ه لە هەسارەکان {
    هێڵڕەنگبکە(ڕەنگی(٨٠، ٨٠، ١٢٠، ٠٫٤))
    ئەستووریبکە(١)
    بازنەهێڵ(٢٥٠، ٢٥٠، ه.دووری)
  }
  خۆر(٢٥٠، ٢٥٠، ٢٨)
  بۆ هەر ه لە هەسارەکان {
    نەگۆڕ گ = کات * ه.خێرایی * پای / ١٨٠
    ڕەنگبکە(ه.ڕەنگ)
    بازنە(٢٥٠ + کۆسینۆس(گ) * ه.دووری، ٢٥٠ + سینۆس(گ) * ه.دووری، ه.قەبارە)
  }
})
