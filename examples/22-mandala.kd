// 🌸 ماندالا — شێوەی جوان بە دووبارەکردنەوەی گۆشە
قەبارە(٤٥٠، ٤٥٠)
پاشبنەمابکە(ڕەنگی(١٠، ١٠، ٢٥))
ئەستووریبکە(٢)

بۆ هەر ئاست لە [٢٠٠، ١٥٠، ١٠٠، ٥٠] {
  بۆ i لە ٠ تا ٣٥ {
    هێڵڕەنگبکە(پەلکەزێڕینە(i * ١٠ + ئاست))
    قەڵەمبەرز()
    بچۆبۆ(٢٢٥، ٢٢٥)
    ڕووبکەبۆ(i * ١٠)
    قەڵەمدابنێ()
    پێشەوە(ئاست * ٠٫٥)
    بۆڕاست(٦٠)
    پێشەوە(ئاست * ٠٫٣)
    بۆڕاست(١٢٠)
    پێشەوە(ئاست * ٠٫٣)
    بۆڕاست(٦٠)
    پێشەوە(ئاست * ٠٫٥)
  }
}
