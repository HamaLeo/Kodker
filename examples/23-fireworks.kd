// 🎆 ئاتەشبازی — کلیک بکە لە هەر شوێنێک بۆ تەقاندنەوە
قەبارە(٥٠٠، ٣٥٠)
گۆڕاو پارچەکان = []
گۆڕاو کات = ٠

کار بتەقێنە(x، y) {
  نەگۆڕ ڕەنگ = هەڕەمەکی(٠، ٣٦٠)
  بۆ i لە ١ تا ٦٠ {
    نەگۆڕ گ = هەڕەمەکی(٠، ٣٦٠) * پای / ١٨٠
    نەگۆڕ خ = هەڕەمەکی(١، ٦)
    پارچەکان.زیادبکە({ x: x، y: y، vx: کۆسینۆس(گ) * خ، vy: سینۆس(گ) * خ، ژیان: ٦٠، ڕەنگ: ڕەنگ + هەڕەمەکی(-٢٠، ٢٠) })
  }
}

یاریبکە(() => {
  کات += ١
  ئەگەر کلیککراوە() { بتەقێنە(ماوسX()، ماوسY()) }
  ئەگەر کات % ٥٠ == ٠ { بتەقێنە(هەڕەمەکی(٥٠، ٤٥٠)، هەڕەمەکی(٣٠، ١٩٠)) }

  پاشبنەمابکە(ڕەنگی(٥، ٥، ١٥))
  گۆڕاو زیندوو = []
  بۆ هەر پ لە پارچەکان {
    پ.x += پ.vx
    پ.y += پ.vy
    پ.vy += ٠٫٠٦
    پ.ژیان -= ١
    ئەگەر پ.ژیان > ٠ {
      ڕەنگبکە(پەلکەزێڕینە(پ.ڕەنگ، پ.ژیان / ٦٠))
      بازنە(پ.x، پ.y، ٣)
      زیندوو.زیادبکە(پ)
    }
  }
  پارچەکان = زیندوو
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٥))
  نووسین("کلیک بکە!", ٢٠٠، ٣٣٠، ١٨)
})
