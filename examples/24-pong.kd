// یاری: پۆنگ — پادەکەت بە ماوس یان تیرەکانی سەرەوە/خوارەوە بجووڵێنە و لە کۆمپیوتەر ببەرەوە. یەکەم کەس بە ٥ خاڵ دەبات
قەبارە(٤٨٠، ٣٠٠)
گۆڕاو پاد = ١١٠
گۆڕاو دژ = ١١٠
گۆڕاو x = ٢٤٠
گۆڕاو y = ١٥٠
گۆڕاو dx = ٤
گۆڕاو dy = ٣
گۆڕاو خاڵی٠ = ٠
گۆڕاو خاڵی١ = ٠

کار دووبارە() {
  x = ٢٤٠
  y = ١٥٠
  dx = (هەڕەمەکی(٠، ١) == ٠ ? -٤ : ٤)
  dy = هەڕەمەکی(-٣، ٣)
  ئەگەر dy == ٠ { dy = ٢ }
}

یاریبکە(() => {
  ئەگەر کلیل("سەرەوە") { پاد -= ٦ }
  ئەگەر کلیل("خوارەوە") { پاد += ٦ }
  ئەگەر ماوسY() >= ٠ { پاد = ماوسY() - ٤٠ }
  پاد = سنوور(پاد، ٠، ٢٢٠)

  // کۆمپیوتەر ئەستێرەکە دەکەوێتەوە، بەڵام کەمێک هێواشە
  ئەگەر y > دژ + ٤٠ { دژ += ٣٫٥ }
  ئەگەر y < دژ + ٤٠ { دژ -= ٣٫٥ }
  دژ = سنوور(دژ، ٠، ٢٢٠)

  x += dx
  y += dy
  ئەگەر y < ٨ یان y > ٢٩٢ { dy = -dy }
  ئەگەر dx < ٠ و x < ٣٠ و x > ١٦ و y > پاد و y < پاد + ٨٠ { dx = -dx * ١٫٠٥ }
  ئەگەر dx > ٠ و x > ٤٥٠ و x < ٤٦٤ و y > دژ و y < دژ + ٨٠ { dx = -dx * ١٫٠٥ }
  ئەگەر x < ٠ { خاڵی١ += ١؛ دووبارە() }
  ئەگەر x > ٤٨٠ { خاڵی٠ += ١؛ دووبارە() }

  پاشبنەمابکە(ڕەنگی(١٠، ١٥، ٣٠))
  ڕەنگبکە(ڕەنگی(٥٠، ٦٠، ٩٠))
  بۆ i لە ٠ تا ١٤ { لاکێش(٢٣٧، i * ٢٠ + ٤، ٦، ١٢) }
  ڕەنگبکە("ئاسمانی")
  لاکێش(١٤، پاد، ١٠، ٨٠)
  ڕەنگبکە("نارنجی")
  لاکێش(٤٥٦، دژ، ١٠، ٨٠)
  ڕەنگبکە("سپی")
  بازنە(x، y، ٨)
  نووسین(خاڵی٠، ١٦٠، ٤٥، ٣٦)
  نووسین(خاڵی١، ٣٢٠، ٤٥، ٣٦)

  ئەگەر خاڵی٠ >= ٥ یان خاڵی١ >= ٥ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٤٨٠، ٣٠٠)
    ڕەنگبکە("سپی")
    نووسین(خاڵی٠ >= ٥ ? "بردتەوە! 🎉" : "کۆمپیوتەر بردیەوە", ١٥٠، ١٤٠، ٣٠)
    نووسین("کلیک بکە بۆ دووبارە", ١٦٠، ١٨٠، ٢٠)
    ئەگەر کلیککراوە() { خاڵی٠ = ٠؛ خاڵی١ = ٠؛ دووبارە() }
  }
})
