// یاری: تەقاندن — کەشتییەکەت بە ← → بجووڵێنە و بە بۆشایی گوللە بەرە؛ دوژمنەکان بتەقێنە
قەبارە(٤٠٠، ٥٠٠)
گۆڕاو کەشتی = ١٨٠
گۆڕاو گوللەکان = []
گۆڕاو دوژمنەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو ژیان = ٣
گۆڕاو کات = ٠
گۆڕاو ئاگر = ٠
نەگۆڕ ئەستێرەکان = []
بۆ i لە ١ تا ٥٠ { ئەستێرەکان.زیادبکە({ x: هەڕەمەکی(٠، ٤٠٠)، y: هەڕەمەکی(٠، ٥٠٠)، خ: هەڕەمەکی(١، ٣) }) }

کار دووبارە() {
  گوللەکان = []
  دوژمنەکان = []
  خاڵ = ٠
  ژیان = ٣
}

یاریبکە(() => {
  کات += ١
  ئاگر -= ١

  ئەگەر ژیان > ٠ {
    ئەگەر کلیل("چەپ") { کەشتی -= ٦ }
    ئەگەر کلیل("ڕاست") { کەشتی += ٦ }
    کەشتی = سنوور(کەشتی، ٠، ٣٦٠)

    ئەگەر (کلیل("بۆشایی") یان ماوسگیراوە()) و ئاگر <= ٠ {
      گوللەکان.زیادبکە({ x: کەشتی + ٢٠، y: ٤٣٠ })
      ئاگر = ١٠
    }
    ئەگەر کات % ٤٥ == ٠ {
      دوژمنەکان.زیادبکە({ x: هەڕەمەکی(١٠، ٣٥٠)، y: -٣٠، خ: هەڕەمەکی(١، ٣) })
    }

    بۆ هەر گ لە گوللەکان { گ.y -= ٩ }
    بۆ هەر د لە دوژمنەکان { د.y += د.خ }

    // پێکدان
    بۆ هەر د لە دوژمنەکان {
      بۆ هەر گ لە گوللەکان {
        ئەگەر دووری(گ.x، گ.y، د.x + ١٥، د.y + ١٥) < ٢٢ {
          د.مردووە = ڕاست
          گ.مردووە = ڕاست
          خاڵ += ١
        }
      }
      ئەگەر د.y > ٥٠٠ { د.مردووە = ڕاست؛ ژیان -= ١ }
    }
    گوللەکان = گوللەکان.پاڵاوتن(گ => نەک گ.مردووە و گ.y > -١٠)
    دوژمنەکان = دوژمنەکان.پاڵاوتن(د => نەک د.مردووە)
  }

  پاشبنەمابکە(ڕەنگی(٥، ٥، ٢٠))
  ڕەنگبکە("سپی")
  بۆ هەر ئ لە ئەستێرەکان {
    ئ.y = (ئ.y + ئ.خ * ٠٫٥) % ٥٠٠
    بازنە(ئ.x، ئ.y، ١٫٥)
  }
  ڕەنگبکە("زەرد")
  بۆ هەر گ لە گوللەکان { لاکێش(گ.x - ٢، گ.y، ٤، ١٢) }
  بۆ هەر د لە دوژمنەکان {
    ڕەنگبکە("سوور")
    سێگۆشە(د.x، د.y، د.x + ٣٠، د.y، د.x + ١٥، د.y + ٣٠)
    ڕەنگبکە("سپی")
    بازنە(د.x + ١٥، د.y + ٨، ٣)
  }
  ڕەنگبکە("ئاسمانی")
  سێگۆشە(کەشتی، ٤٦٠، کەشتی + ٤٠، ٤٦٠، کەشتی + ٢٠، ٤٣٠)
  ڕەنگبکە("نارنجی")
  سێگۆشە(کەشتی + ١٥، ٤٦٠، کەشتی + ٢٥، ٤٦٠، کەشتی + ٢٠، ٤٦٠ + ٦ + (کات % ٤) * ٢)
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٨، ٢٠)
  نووسین("❤ " + گەورەترین(ژیان، ٠)، ٣٤٠، ٢٨، ٢٠)

  ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٤٠٠، ٥٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! خاڵ: " + خاڵ، ٩٠، ٢٣٠، ٣٠)
    نووسین("کلیک بکە بۆ دووبارە", ٩٥، ٢٧٠، ٢٠)
    ئەگەر کلیککراوە() { دووبارە() }
  }
})
