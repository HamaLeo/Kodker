// یاری: مشک بکوژە — هەر مشکێک کە دەرکەوت کلیکی لێ بکە پێش ئەوەی ون بێت!
قەبارە(٤٠٠، ٣٢٠)
گۆڕاو خاڵ = ٠
گۆڕاو کات = ٣٠ * ٦٠
گۆڕاو کون = -١
گۆڕاو ماوە = ٠
گۆڕاو لێدان = ٠

کار شوێن(i) {
  گەڕێنەوە { x: ٧٠ + (i % ٣) * ١٣٠، y: ١٣٠ + خوارکە(i / ٣) * ٩٠ }
}

یاریبکە(() => {
  ئەگەر کات > ٠ {
    کات -= ١
    ماوە -= ١
    ئەگەر ماوە <= ٠ { کون = هەڕەمەکی(٠، ٥)؛ ماوە = هەڕەمەکی(٣٠، ٦٠) }
    ئەگەر کلیککراوە() {
      گۆڕاو ش = شوێن(کون)
      ئەگەر کون >= ٠ و دووری(ماوسX()، ماوسY()، ش.x، ش.y) < ٣٨ {
        خاڵ += ١
        لێدان = ١٠
        کون = -١
        ماوە = ٢٥
      }
    }
  }
  لێدان -= ١

  پاشبنەمابکە(ڕەنگی(٤٠، ١٢٠، ٥٠))
  بۆ i لە ٠ تا ٥ {
    گۆڕاو ش = شوێن(i)
    ڕەنگبکە(ڕەنگی(٦٠، ٤٠، ٢٠))
    بازنە(ش.x، ش.y + ٥، ٤٢)
    ڕەنگبکە(ڕەنگی(٢٠، ١٥، ١٠))
    بازنە(ش.x، ش.y، ٣٨)
    ئەگەر i == کون {
      ڕەنگبکە(ڕەنگی(١٥٠، ١٠٠، ٦٠))
      بازنە(ش.x، ش.y، ٣٠)
      ڕەنگبکە("سپی")
      بازنە(ش.x - ١٠، ش.y - ٧، ٥)
      بازنە(ش.x + ١٠، ش.y - ٧، ٥)
      ڕەنگبکە("ڕەش")
      بازنە(ش.x - ١٠، ش.y - ٧، ٢)
      بازنە(ش.x + ١٠، ش.y - ٧، ٢)
      ڕەنگبکە("پەمەیی")
      بازنە(ش.x، ش.y + ٧، ٥)
    }
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٥، ٣٥، ٢٦)
  نووسین("کات: " + خوارکە(کات / ٦٠)، ٢٨٠، ٣٥، ٢٦)
  ئەگەر لێدان > ٠ { نووسین("✨ باشە!", ١٦٠، ٨٠، ٢٤) }
  ئەگەر کات <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٧))
    لاکێش(٠، ٠، ٤٠٠، ٣٢٠)
    ڕەنگبکە("سپی")
    نووسین("کاتەکە تەواو بوو! خاڵ: " + خاڵ، ٨٠، ١٥٠، ٢٦)
    نووسین("کلیک بکە بۆ دووبارە", ١١٠، ١٩٠، ٢٠)
    ئەگەر کلیککراوە() { خاڵ = ٠؛ کات = ١٨٠٠ }
  }
})
