// یاری: ئێکس-ئۆ — تۆ ✕ ی، کۆمپیوتەر ◯. کلیک بکە لە خانەیەکی بەتاڵ
قەبارە(٣٠٠، ٣٦٠)
گۆڕاو تەخت = [٠، ٠، ٠، ٠، ٠، ٠، ٠، ٠، ٠]    // ٠ = بەتاڵ، ١ = تۆ، ٢ = کۆمپیوتەر
گۆڕاو نۆرەی = ١
گۆڕاو چاوەڕێ = ٠
گۆڕاو ئەنجام = ٠                             // ٠ = بەردەوام، ١/٢ = براوە، ٣ = یەکسان

نەگۆڕ هێڵەکان = [[٠، ١، ٢]، [٣، ٤، ٥]، [٦، ٧، ٨]، [٠، ٣، ٦]، [١، ٤، ٧]، [٢، ٥، ٨]، [٠، ٤، ٨]، [٢، ٤، ٦]]

کار براوە(ت) {
  بۆ هەر ه لە هێڵەکان {
    ئەگەر ت[ه[٠]] != ٠ و ت[ه[٠]] == ت[ه[١]] و ت[ه[٠]] == ت[ه[٢]] { گەڕێنەوە ت[ه[٠]] }
  }
  ئەگەر نەک ت.لەخۆدەگرێت(٠) { گەڕێنەوە ٣ }
  گەڕێنەوە ٠
}

// کۆمپیوتەر: یەکەم ببەرەوە، پاشان دژەکەت بوەستێنە، پاشان ناوەند، پاشان هەر شوێنێک
کار بڕیاری_کۆمپیوتەر() {
  بۆ هەر کێ لە [٢، ١] {
    بۆ i لە ٠ تا ٨ {
      ئەگەر تەخت[i] == ٠ {
        تەخت[i] = کێ
        نەگۆڕ ب = براوە(تەخت) == کێ
        تەخت[i] = ٠
        ئەگەر ب { گەڕێنەوە i }
      }
    }
  }
  ئەگەر تەخت[٤] == ٠ { گەڕێنەوە ٤ }
  نەگۆڕ بەتاڵ = []
  بۆ i لە ٠ تا ٨ { ئەگەر تەخت[i] == ٠ { بەتاڵ.زیادبکە(i) } }
  گەڕێنەوە بەتاڵ[هەڕەمەکی(٠، بەتاڵ.درێژی - ١)]
}

یاریبکە(() => {
  ئەگەر ئەنجام == ٠ {
    ئەگەر نۆرەی == ١ {
      ئەگەر کلیککراوە() و ماوسY() < ٣٠٠ {
        نەگۆڕ خانە = خوارکە(ماوسX() / ١٠٠) + خوارکە(ماوسY() / ١٠٠) * ٣
        ئەگەر تەخت[خانە] == ٠ { تەخت[خانە] = ١؛ نۆرەی = ٢؛ چاوەڕێ = ٣٠ }
      }
    } ئەگەرنا {
      چاوەڕێ -= ١
      ئەگەر چاوەڕێ <= ٠ { تەخت[بڕیاری_کۆمپیوتەر()] = ٢؛ نۆرەی = ١ }
    }
    ئەنجام = براوە(تەخت)
  } ئەگەرنا ئەگەر کلیککراوە() {
    تەخت = [٠، ٠، ٠، ٠، ٠، ٠، ٠، ٠، ٠]
    ئەنجام = ٠
    نۆرەی = ١
  }

  پاشبنەمابکە(ڕەنگی(١٥، ٢٠، ٤٠))
  هێڵڕەنگبکە(ڕەنگی(٨٠، ٩٠، ١٣٠))
  ئەستووریبکە(٤)
  هێڵ(١٠٠، ١٠، ١٠٠، ٢٩٠)؛ هێڵ(٢٠٠، ١٠، ٢٠٠، ٢٩٠)
  هێڵ(١٠، ١٠٠، ٢٩٠، ١٠٠)؛ هێڵ(١٠، ٢٠٠، ٢٩٠، ٢٠٠)
  بۆ i لە ٠ تا ٨ {
    نەگۆڕ cx = (i % ٣) * ١٠٠ + ٥٠
    نەگۆڕ cy = خوارکە(i / ٣) * ١٠٠ + ٥٠
    ئەستووریبکە(٩)
    ئەگەر تەخت[i] == ١ {
      هێڵڕەنگبکە("ئاسمانی")
      هێڵ(cx - ٢٨، cy - ٢٨، cx + ٢٨، cy + ٢٨)؛ هێڵ(cx + ٢٨، cy - ٢٨، cx - ٢٨، cy + ٢٨)
    } ئەگەرنا ئەگەر تەخت[i] == ٢ {
      هێڵڕەنگبکە("نارنجی")
      بازنەهێڵ(cx، cy، ٣٠)
    }
  }
  ڕەنگبکە("سپی")
  گۆڕاو پەیام = "نۆرەی تۆیە — کلیک بکە"
  ئەگەر نۆرەی == ٢ { پەیام = "کۆمپیوتەر بیر دەکاتەوە..." }
  ئەگەر ئەنجام == ١ { پەیام = "بردتەوە! 🎉 (کلیک = دووبارە)" }
  ئەگەر ئەنجام == ٢ { پەیام = "کۆمپیوتەر بردیەوە (کلیک = دووبارە)" }
  ئەگەر ئەنجام == ٣ { پەیام = "یەکسان بوون (کلیک = دووبارە)" }
  نووسین(پەیام، ٤٠، ٣٣٥، ٢٠)
})
