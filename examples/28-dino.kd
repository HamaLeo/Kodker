// یاری: ڕاکردن — بە بۆشایی یان سەرەوە یان کلیک باز بدە و لە کاکتووسەکان تێپەڕە
قەبارە(٥٠٠، ٢٠٠)
نەگۆڕ زەوی = ١٦٠
گۆڕاو y = زەوی
گۆڕاو vy = ٠
گۆڕاو کاکتووسەکان = [{ x: ٦٠٠، پان: ٢٠، بەرز: ٤٠ }]
گۆڕاو خێرایی = ٥
گۆڕاو خاڵ = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو کات = ٠
گۆڕاو بەرزترین = ٠

کار دووبارە() {
  y = زەوی؛ vy = ٠
  کاکتووسەکان = [{ x: ٦٠٠، پان: ٢٠، بەرز: ٤٠ }]
  خێرایی = ٥؛ خاڵ = ٠؛ مردووە = هەڵە
}

یاریبکە(() => {
  کات += ١
  گۆڕاو باز = کلیل("بۆشایی") یان کلیل("سەرەوە") یان ماوسگیراوە()
  ئەگەر مردووە {
    ئەگەر کلیککراوە() { دووبارە() }
  } ئەگەرنا {
    ئەگەر باز و y >= زەوی { vy = -١٢ }
    vy += ٠٫٧
    y += vy
    ئەگەر y >= زەوی { y = زەوی؛ vy = ٠ }

    بۆ هەر ک لە کاکتووسەکان { ک.x -= خێرایی }
    ئەگەر کاکتووسەکان[٠].x < -٥٠ { کاکتووسەکان.یەکەمیلابەرە() }
    نەگۆڕ دوایین = کاکتووسەکان[کاکتووسەکان.درێژی - ١]
    ئەگەر دوایین.x < ٥٠٠ - هەڕەمەکی(٢٣٠، ٣٨٠) {
      کاکتووسەکان.زیادبکە({ x: ٥٢٠، پان: هەڕەمەکی(١٥، ٣٠)، بەرز: هەڕەمەکی(٣٠، ٥٥) })
    }
    بۆ هەر ک لە کاکتووسەکان {
      ئەگەر ک.x < ٩٠ و ک.x + ک.پان > ٦٠ و y > زەوی - ک.بەرز + ٥ { مردووە = ڕاست }
    }
    خاڵ += ١
    بەرزترین = گەورەترین(بەرزترین، خوارکە(خاڵ / ٦))
    خێرایی = ٥ + خاڵ / ٦٠٠
  }

  پاشبنەمابکە(ڕەنگی(٢٤٥، ٢٣٥، ٢١٠))
  ڕەنگبکە(ڕەنگی(٢٣٥، ٢٢٠، ١٨٠))
  بازنە(((کات * ٠٫٣) % ٦٠٠) - ٥٠، ٤٠، ٢٥)
  ڕەنگبکە(ڕەنگی(٢٠٠، ١٨٠، ١٤٠))
  لاکێش(٠، زەوی + ٢٠، ٥٠٠، ٢٠)
  بۆ i لە ٠ تا ٩ { لاکێش(((i * ٦٣ - کات * خێرایی) % ٥٦٠ + ٥٦٠) % ٥٦٠ - ٣٠، زەوی + ٢٨، ١٠، ٣) }
  ڕەنگبکە(ڕەنگی(٣٠، ١٢٠، ٦٠))
  بۆ هەر ک لە کاکتووسەکان {
    لاکێش(ک.x، زەوی + ٢٠ - ک.بەرز، ک.پان، ک.بەرز)
    لاکێش(ک.x - ٥، زەوی + ٢٠ - ک.بەرز * ٠٫٦، ٥، ٨)
  }
  // دینۆسۆر
  ڕەنگبکە(ڕەنگی(٦٠، ٦٠، ٦٠))
  لاکێش(٦٠، y - ٢٠، ٣٠، ٤٠)
  لاکێش(٧٥، y - ٣٢، ٢٥، ٢٠)
  ڕەنگبکە("سپی")
  بازنە(٩٣، y - ٢٦، ٣)
  ڕەنگبکە(ڕەنگی(٦٠، ٦٠، ٦٠))
  ئەگەر y >= زەوی { لاکێش(٦٥ + (کات % ١٠ < ٥ ? ٠ : ١٥)، y + ٢٠، ٨، ٨) }
  ڕەنگبکە(ڕەنگی(٨٠، ٨٠، ٨٠))
  نووسین("خاڵ " + خوارکە(خاڵ / ٦)، ٣٦٠، ٣٠، ٢٠)
  نووسین("باشترین " + بەرزترین، ٣٦٠، ٥٦، ١٦)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٥٠٠، ٢٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی!", ٢٠٠، ٩٠، ٣٠)
    نووسین("کلیک بکە بۆ دووبارە", ١٨٠، ١٣٠، ٢٠)
  }
})
