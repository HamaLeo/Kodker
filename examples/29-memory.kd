// یاری: بیرەوەری — جووتە کارتەکان بدۆزەوە. دوو کارت بکەرەوە، ئەگەر یەکسان بوون دەمێننەوە
قەبارە(٤٠٠، ٤٦٠)
گۆڕاو کارتەکان = []
گۆڕاو کراوە = []          // ئیندێکسی کارتە کراوەکان (٢ لە یەک کاتدا)
گۆڕاو چاوەڕێ = ٠
گۆڕاو هەوڵ = ٠
گۆڕاو جووت = ٠

کار تێکەڵ() {
  نەگۆڕ ل = []
  بۆ i لە ٠ تا ٧ { ل.زیادبکە(i)؛ ل.زیادبکە(i) }
  // تێکەڵکردن
  بۆ i لە ل.درێژی - ١ تا ١ هەنگاو -١ {
    نەگۆڕ j = هەڕەمەکی(٠، i)
    نەگۆڕ تێکەڵ_ = ل[i]؛ ل[i] = ل[j]؛ ل[j] = تێکەڵ_
  }
  کارتەکان = ل.نەخشە(ن => ({ نرخ: ن، دۆزراوەتەوە: هەڵە }))
  کراوە = []؛ هەوڵ = ٠؛ جووت = ٠
}
تێکەڵ()

یاریبکە(() => {
  ئەگەر چاوەڕێ > ٠ {
    چاوەڕێ -= ١
    ئەگەر چاوەڕێ == ٠ { کراوە = [] }
  } ئەگەرنا ئەگەر کلیککراوە() {
    ئەگەر جووت == ٨ { تێکەڵ() } ئەگەرنا ئەگەر ماوسY() > ٦٠ {
      نەگۆڕ ستوون = خوارکە(ماوسX() / ١٠٠)
      نەگۆڕ ڕیز = خوارکە((ماوسY() - ٦٠) / ٩٥)
      نەگۆڕ i = ڕیز * ٤ + ستوون
      ئەگەر ڕیز >= ٠ و ڕیز < ٤ و ستوون < ٤ و نەک کارتەکان[i].دۆزراوەتەوە و نەک کراوە.لەخۆدەگرێت(i) {
        کراوە.زیادبکە(i)
        ئەگەر کراوە.درێژی == ٢ {
          هەوڵ += ١
          ئەگەر کارتەکان[کراوە[٠]].نرخ == کارتەکان[کراوە[١]].نرخ {
            کارتەکان[کراوە[٠]].دۆزراوەتەوە = ڕاست
            کارتەکان[کراوە[١]].دۆزراوەتەوە = ڕاست
            جووت += ١
            کراوە = []
          } ئەگەرنا { چاوەڕێ = ٤٥ }
        }
      }
    }
  }

  پاشبنەمابکە(ڕەنگی(٢٠، ٢٥، ٤٥))
  بۆ i لە ٠ تا ١٥ {
    نەگۆڕ x = (i % ٤) * ١٠٠ + ٨
    نەگۆڕ y = خوارکە(i / ٤) * ٩٥ + ٦٨
    نەگۆڕ ک = کارتەکان[i]
    ئەگەر ک.دۆزراوەتەوە یان کراوە.لەخۆدەگرێت(i) {
      ڕەنگبکە(پەلکەزێڕینە(ک.نرخ * ٤٥))
      لاکێش(x، y، ٨٤، ٨٠)
      ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٨))
      ئەستێرە(x + ٤٢، y + ٤٠، ٢٠ + (ک.نرخ % ٣) * ٣، ک.نرخ % ٤ + ٣)
    } ئەگەرنا {
      ڕەنگبکە(ڕەنگی(٧٠، ٨٠، ١٢٠))
      لاکێش(x، y، ٨٤، ٨٠)
      ڕەنگبکە(ڕەنگی(١٠٠، ١١٠، ١٦٠))
      نووسین("؟", x + ٣٠، y + ٥٥، ٤٠)
    }
  }
  ڕەنگبکە("سپی")
  نووسین("هەوڵ: " + هەوڵ، ٢٠، ٣٨، ٢٤)
  نووسین("جووت: " + جووت + "/٨", ٢٦٠، ٣٨، ٢٤)
  ئەگەر جووت == ٨ { نووسین("🎉 بردتەوە! کلیک = دووبارە", ٨٠، ٤٥٠، ٢٠) }
})
