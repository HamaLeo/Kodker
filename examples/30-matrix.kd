// 🟩 باراني ماتریکس — پیت و ژمارەی دەکەون
قەبارە(٥٠٠، ٣٢٠)
نەگۆڕ پیتەکان = "01ئابپتجچحخدڕزسشعغفقکگلمنوهیABXZ".دابەشبکە("")
نەگۆڕ ستوونەکان = []
بۆ i لە ٠ تا ٢٩ { ستوونەکان.زیادبکە({ y: هەڕەمەکی(-٢٠، ٢٠)، خ: هەڕەمەکی(٢، ٦)، پیتەکان: [] }) }

یاریبکە(() => {
  پاشبنەمابکە("ڕەش")
  بۆ i لە ٠ تا ٢٩ {
    نەگۆڕ س = ستوونەکان[i]
    س.y += س.خ
    ئەگەر س.y % ١٤ < س.خ { س.پیتەکان.زیادبکە(پیتەکان[هەڕەمەکی(٠، پیتەکان.درێژی - ١)]) }
    ئەگەر س.y > ٣٦٠ + س.پیتەکان.درێژی { س.y = هەڕەمەکی(-٢٠، ٠)؛ س.پیتەکان = [] }
    بۆ j لە ٠ تا س.پیتەکان.درێژی - ١ {
      نەگۆڕ ڕووناکی = ١ - (س.پیتەکان.درێژی - j) / ٢٢
      ئەگەر ڕووناکی > ٠ {
        ڕەنگبکە(j == س.پیتەکان.درێژی - ١ ? "سپی" : ڕەنگی(٢٠، ٢٥٥، ٨٠، ڕووناکی))
        نووسین(س.پیتەکان[j]، i * ١٧ - ٤، س.y - (س.پیتەکان.درێژی - j) * ١٤ + ١٤، ١٤)
      }
    }
    ئەگەر س.پیتەکان.درێژی > ٢٢ { س.پیتەکان.یەکەمیلابەرە() }
  }
})
