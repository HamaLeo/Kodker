// 〰 لیساجوس — دوو شەپۆلی سینۆس ڕەنگاوڕەنگ و جوان دەکێشن. ماوس بجووڵێنە بۆ گۆڕینی شێوە
قەبارە(٤٠٠، ٤٠٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٢
  نەگۆڕ a = ماوسX() >= ٠ ? ٢ + ماوسX() / ١٠٠ : ٣
  نەگۆڕ b = ماوسY() >= ٠ ? ٢ + ماوسY() / ١٠٠ : ٢
  پاشبنەمابکە(ڕەنگی(١٠، ١٠، ٢٥))
  بۆ i لە ٠ تا ٣٠٠ {
    نەگۆڕ t = i * ٠٫٠٢
    نەگۆڕ x = ٢٠٠ + ١٦٠ * سینۆس(a * t + کات)
    نەگۆڕ y = ٢٠٠ + ١٦٠ * سینۆس(b * t)
    ڕەنگبکە(پەلکەزێڕینە(i * ١٫٢ + کات * ٥٠، ٠٫٨))
    بازنە(x، y، ٣)
  }
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٦))
  نووسین("a=" + a.دەهەک(١) + "  b=" + b.دەهەک(١)، ١٥، ٣٠، ١٦)
})
