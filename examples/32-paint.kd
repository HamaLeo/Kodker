// 🖌 پەنجەنگار — بە ماوس یان پەنجە بکێشە. ڕەنگێک هەڵبژێرە لە سەرەوە، یان کلیلی ١ تا ٥. کلیلی «پ» پاک دەکاتەوە
قەبارە(٥٠٠، ٣٢٠)
نەگۆڕ ڕەنگەکان = ["سپی"، "سوور"، "زەرد"، "سەوز"، "ئاسمانی"]
گۆڕاو ڕەنگ = ٠
گۆڕاو خاڵەکان = []
گۆڕاو قەڵەم = ٦

یاریبکە(() => {
  بۆ i لە ٠ تا ٤ { ئەگەر کلیل(بکەدەق(i + ١)) { ڕەنگ = i } }
  ئەگەر کلیل("p") یان کلیل("پ") { خاڵەکان = [] }
  ئەگەر کلیل("ئینتەر") { خاڵەکان = [] }

  ئەگەر ماوسگیراوە() {
    ئەگەر ماوسY() < ٤٠ {
      بۆ i لە ٠ تا ٤ { ئەگەر دووری(ماوسX()، ماوسY()، ٣٠ + i * ٤٠، ٢٠) < ١٦ { ڕەنگ = i } }
    } ئەگەرنا {
      خاڵەکان.زیادبکە({ x: ماوسX()، y: ماوسY()، ڕ: ڕەنگەکان[ڕەنگ]، پ: قەڵەم })
      ئەگەر خاڵەکان.درێژی > ٢٥٠٠ { خاڵەکان.یەکەمیلابەرە() }
    }
  }

  پاشبنەمابکە(ڕەنگی(٢٠، ٢٥، ٤٠))
  بۆ هەر ن لە خاڵەکان {
    ڕەنگبکە(ن.ڕ)
    بازنە(ن.x، ن.y، ن.پ)
  }
  ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
  لاکێش(٠، ٠، ٥٠٠، ٤٠)
  بۆ i لە ٠ تا ٤ {
    ڕەنگبکە(ڕەنگەکان[i])
    بازنە(٣٠ + i * ٤٠، ٢٠، ١٢)
    ئەگەر i == ڕەنگ {
      هێڵڕەنگبکە("سپی")
      ئەستووریبکە(٢)
      بازنەهێڵ(٣٠ + i * ٤٠، ٢٠، ١٧)
    }
  }
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٦))
  نووسین("پ = پاککردنەوە", ٣٦٠، ٢٦، ١٥)
})
