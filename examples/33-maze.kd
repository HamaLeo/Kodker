// یاری: پیچەڵپێچ — بە تیرەکان بڕۆ، هەموو سکەکان کۆبکەرەوە و بگەرە بۆ دەرگای دەرچوون 🚪
قەبارە(٤٥٠، ٣٦٠)
// # = دیوار   . = سکە   S = دەستپێک   E = دەرچوون
نەگۆڕ قۆناغەکان = [
  [
    "###############",
    "#S..#.....#...#",
    "#.#.#.###.#.#.#",
    "#.#...#...#.#.#",
    "#.#####.###.#.#",
    "#.....#.#...#.#",
    "###.#.#.#.###.#",
    "#...#...#.....#",
    "#.#########.#.#",
    "#...........#E#",
    "###############",
  ]،
  [
    "###############",
    "#S#...#.....#E#",
    "#.#.#.#.###.#.#",
    "#...#...#.#...#",
    "#####.###.#.###",
    "#.....#...#...#",
    "#.#####.###.#.#",
    "#.#...#.....#.#",
    "#.#.#.#######.#",
    "#...#.........#",
    "###############",
  ]،
]
گۆڕاو قۆناغ = ٠
گۆڕاو px = ١
گۆڕاو py = ١
گۆڕاو سکەکان = {}
گۆڕاو کۆکراوە = ٠
گۆڕاو کۆی = ٠
گۆڕاو هەنگاو = ٠
گۆڕاو کات = ٠

کار دەستپێکردن(ق) {
  نەگۆڕ نەخشە = قۆناغەکان[ق]
  سکەکان = {}؛ کۆکراوە = ٠؛ کۆی = ٠
  بۆ y لە ٠ تا نەخشە.درێژی - ١ {
    بۆ x لە ٠ تا نەخشە[y].درێژی - ١ {
      نەگۆڕ ش = نەخشە[y][x]
      ئەگەر ش == "S" { px = x؛ py = y }
      ئەگەر ش == "." { سکەکان[x + "," + y] = ڕاست؛ کۆی += ١ }
    }
  }
}
دەستپێکردن(٠)

یاریبکە(() => {
  کات += ١
  نەگۆڕ نەخشە = قۆناغەکان[قۆناغ]
  ئەگەر کات % ٧ == ٠ {
    گۆڕاو dx = ٠
    گۆڕاو dy = ٠
    ئەگەر کلیل("چەپ") { dx = -١ }
    ئەگەر کلیل("ڕاست") { dx = ١ }
    ئەگەر کلیل("سەرەوە") { dy = -١ }
    ئەگەر کلیل("خوارەوە") { dy = ١ }
    ئەگەر (dx != ٠ یان dy != ٠) و نەخشە[py + dy][px + dx] != "#" {
      px += dx؛ py += dy؛ هەنگاو += ١
      ئەگەر سکەکان[px + "," + py] { سکەکان[px + "," + py] = هەڵە؛ کۆکراوە += ١ }
      ئەگەر نەخشە[py][px] == "E" و کۆکراوە == کۆی {
        قۆناغ = (قۆناغ + ١) % قۆناغەکان.درێژی
        دەستپێکردن(قۆناغ)
      }
    }
  }

  پاشبنەمابکە(ڕەنگی(١٠، ١٤، ٣٠))
  بۆ y لە ٠ تا نەخشە.درێژی - ١ {
    بۆ x لە ٠ تا نەخشە[y].درێژی - ١ {
      نەگۆڕ ش = نەخشە[y][x]
      ئەگەر ش == "#" {
        ڕەنگبکە(ڕەنگی(٤٠، ٥٥، ١٢٠))
        لاکێش(x * ٣٠، y * ٣٠ + ٣٠، ٣٠، ٣٠)
        ڕەنگبکە(ڕەنگی(٦٠، ٨٠، ١٦٠))
        لاکێش(x * ٣٠ + ٢، y * ٣٠ + ٣٢، ٢٦، ٢٦)
      } ئەگەرنا ئەگەر ش == "E" {
        ڕەنگبکە(کۆکراوە == کۆی ? "سەوز" : "خۆڵەمێشی")
        لاکێش(x * ٣٠ + ٥، y * ٣٠ + ٣٥، ٢٠، ٢٠)
      }
      ئەگەر سکەکان[x + "," + y] {
        ڕەنگبکە("زەرد")
        بازنە(x * ٣٠ + ١٥، y * ٣٠ + ٤٥، ٥)
      }
    }
  }
  ڕەنگبکە("سوور")
  بازنە(px * ٣٠ + ١٥، py * ٣٠ + ٤٥، ١٢)
  ڕەنگبکە("سپی")
  بازنە(px * ٣٠ + ١٢، py * ٣٠ + ٤٢، ٣)
  بازنە(px * ٣٠ + ١٩، py * ٣٠ + ٤٢، ٣)
  ڕەنگبکە("سپی")
  نووسین("قۆناغ " + (قۆناغ + ١)، ١٠، ٢٢، ١٨)
  نووسین("سکە: " + کۆکراوە + "/" + کۆی، ١٦٠، ٢٢، ١٨)
  نووسین("هەنگاو: " + هەنگاو، ٣٣٠، ٢٢، ١٨)
})
