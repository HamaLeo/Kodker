// یاری: ڕێگا — بە ← → ئوتومبێلەکەت بگۆڕە بۆ هێڵەکەی تر و لە ئوتومبێلەکان ڕابکە
قەبارە(٣٠٠، ٥٠٠)
گۆڕاو هێڵ = ١
گۆڕاو ئوتومبێلەکان = []
گۆڕاو خێرایی = ٥
گۆڕاو خاڵ = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو کات = ٠
گۆڕاو پێشوو = هەڵە
گۆڕاو بەرزترین = ٠

کار ئوتومبێل(x، y، ڕەنگ) {
  ڕەنگبکە(ڕەنگ)
  لاکێش(x، y، ٤٦، ٧٤)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٨))
  لاکێش(x + ٨، y + ١٢، ٣٠، ١٨)
  لاکێش(x + ٨، y + ٤٨، ٣٠، ١٢)
  ڕەنگبکە("ڕەش")
  لاکێش(x - ٤، y + ٩، ٦، ١٦)؛ لاکێش(x + ٤٤، y + ٩، ٦، ١٦)
  لاکێش(x - ٤، y + ٤٨، ٦، ١٦)؛ لاکێش(x + ٤٤، y + ٤٨، ٦، ١٦)
}

کار دووبارە() {
  ئوتومبێلەکان = []؛ خێرایی = ٥؛ خاڵ = ٠؛ مردووە = هەڵە؛ هێڵ = ١
}

یاریبکە(() => {
  کات += ١
  نەگۆڕ دەستچەپ = کلیل("چەپ")
  نەگۆڕ دەستڕاست = کلیل("ڕاست")
  ئەگەر نەک مردووە {
    ئەگەر دەستچەپ و نەک پێشوو { هێڵ = گەورەترین(٠، هێڵ - ١) }
    ئەگەر دەستڕاست و نەک پێشوو { هێڵ = بچووکترین(٢، هێڵ + ١) }
    ئەگەر ماوسگیراوە() { هێڵ = سنوور(خوارکە(ماوسX() / ١٠٠)، ٠، ٢) }

    ئەگەر کات % خوارکە(٧٠ - بچووکترین(٤٠، خاڵ / ١٠)) == ٠ {
      ئوتومبێلەکان.زیادبکە({ هێڵ: هەڕەمەکی(٠، ٢)، y: -٩٠، ڕەنگ: پەلکەزێڕینە(هەڕەمەکی(٠، ٣٦٠)) })
    }
    بۆ هەر ئ لە ئوتومبێلەکان {
      ئ.y += خێرایی
      ئەگەر ئ.هێڵ == هێڵ و ئ.y > ٣٤٠ و ئ.y < ٤٣٠ { مردووە = ڕاست }
    }
    نەگۆڕ ماوە = ئوتومبێلەکان.پاڵاوتن(ئ => ئ.y < ٥٢٠)
    خاڵ += ئوتومبێلەکان.درێژی - ماوە.درێژی
    ئوتومبێلەکان = ماوە
    خێرایی = ٥ + خاڵ / ٨
    بەرزترین = گەورەترین(بەرزترین، خاڵ)
  }
  پێشوو = دەستچەپ یان دەستڕاست

  پاشبنەمابکە(ڕەنگی(٣٠، ٣٠، ٣٨))
  ڕەنگبکە(ڕەنگی(٨٠، ١٦٠، ٨٠))
  لاکێش(٠، ٠، ١٠، ٥٠٠)؛ لاکێش(٢٩٠، ٠، ١٠، ٥٠٠)
  ڕەنگبکە(ڕەنگی(٢٢٠، ٢٢٠، ٢٢٠))
  بۆ i لە ٠ تا ٩ {
    نەگۆڕ yy = ((i * ٥٥ + کات * خێرایی) % ٥٥٠) - ٥٠
    لاکێش(٩٨، yy، ٤، ٢٥)؛ لاکێش(١٩٨، yy، ٤، ٢٥)
  }
  بۆ هەر ئ لە ئوتومبێلەکان { ئوتومبێل(ئ.هێڵ * ١٠٠ + ٢٧، ئ.y، ئ.ڕەنگ) }
  ئوتومبێل(هێڵ * ١٠٠ + ٢٧، ٣٧٠، "سپی")
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ٢٠، ٣٥، ٢٤)
  نووسین("باشترین: " + بەرزترین، ٢٠، ٦٠، ١٦)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٢٠٠، ٠، ٠، ٠٫٥))
    لاکێش(٠، ٠، ٣٠٠، ٥٠٠)
    ڕەنگبکە("سپی")
    نووسین("ڕووداو! 💥", ٩٠، ٢٣٠، ٣٢)
    نووسین("کلیک = دووبارە", ٩٥، ٢٧٠، ٢٠)
    ئەگەر کلیککراوە() { دووبارە() }
  }
})
