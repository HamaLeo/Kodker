// یاری: سایمن — ڕیزبەندی ڕەنگەکان ببینە و دووبارەی بکەرەوە بە کلیک. ڕیزەکە هەر جارێک درێژتر دەبێت
قەبارە(٣٠٠، ٣٤٠)
نەگۆڕ ڕەنگەکان = [[٢٣٠، ٥٠، ٥٠]، [٥٠، ١٨٠، ٨٠]، [٦٠، ١٠٠، ٢٣٠]، [٢٤٠، ٢٠٠، ٥٠]]
گۆڕاو ڕیز = [هەڕەمەکی(٠، ٣)]
گۆڕاو دۆخ = "نیشان"          // نیشان، تۆ، کۆتایی
گۆڕاو کات = -٣٠
گۆڕاو شوێن = ٠
گۆڕاو درەوشاوە = -١
گۆڕاو درەوشانەوە = ٠

یاریبکە(() => {
  درەوشانەوە -= ١
  ئەگەر درەوشانەوە <= ٠ { درەوشاوە = -١ }

  ئەگەر دۆخ == "نیشان" {
    کات += ١
    ئەگەر کات >= ٠ {
      نەگۆڕ ی = خوارکە(کات / ٤٠)
      ئەگەر ی < ڕیز.درێژی {
        درەوشاوە = کات % ٤٠ < ٢٨ ? ڕیز[ی] : -١
      } ئەگەرنا { دۆخ = "تۆ"؛ شوێن = ٠؛ درەوشاوە = -١ }
    }
  } ئەگەرنا ئەگەر دۆخ == "تۆ" {
    ئەگەر کلیککراوە() {
      نەگۆڕ q = خوارکە(ماوسX() / ١٥٠) + خوارکە((ماوسY() - ٤٠) / ١٥٠) * ٢
      ئەگەر ماوسY() > ٤٠ و q >= ٠ و q <= ٣ {
        درەوشاوە = q؛ درەوشانەوە = ١٢
        ئەگەر q == ڕیز[شوێن] {
          شوێن += ١
          ئەگەر شوێن == ڕیز.درێژی { ڕیز.زیادبکە(هەڕەمەکی(٠، ٣))؛ دۆخ = "نیشان"؛ کات = -٣٠ }
        } ئەگەرنا { دۆخ = "کۆتایی" }
      }
    }
  } ئەگەرنا ئەگەر کلیککراوە() {
    ڕیز = [هەڕەمەکی(٠، ٣)]؛ دۆخ = "نیشان"؛ کات = -٣٠
  }

  پاشبنەمابکە(ڕەنگی(١٥، ١٥، ٢٥))
  بۆ q لە ٠ تا ٣ {
    نەگۆڕ c = ڕەنگەکان[q]
    نەگۆڕ لێ = درەوشاوە == q
    ڕەنگبکە(لێ ? ڕەنگی(c[٠] + ٢٥ > ٢٥٥ ? ٢٥٥ : c[٠] + ٢٥، c[١] + ٢٥ > ٢٥٥ ? ٢٥٥ : c[١] + ٢٥، c[٢] + ٢٥ > ٢٥٥ ? ٢٥٥ : c[٢] + ٢٥) : ڕەنگی(c[٠] * ٠٫٤، c[١] * ٠٫٤، c[٢] * ٠٫٤))
    لاکێش((q % ٢) * ١٥٠ + ٤، خوارکە(q / ٢) * ١٥٠ + ٤٤، ١٤٢، ١٤٢)
  }
  ڕەنگبکە("سپی")
  نووسین("ئاست: " + ڕیز.درێژی، ١٠، ٢٨، ٢٠)
  نووسین(دۆخ == "نیشان" ? "ببینە..." : دۆخ == "تۆ" ? "نۆرەی تۆیە!" : "هەڵە! کلیک = دووبارە", ١٢٠، ٢٨، ٢٠)
})
