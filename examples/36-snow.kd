// ❄ بەفر — شەوێکی بەفراوی. ماوس بجووڵێنە بۆ گۆڕینی با
قەبارە(٥٠٠، ٣٢٠)
نەگۆڕ پەڵەکان = []
بۆ i لە ١ تا ١٥٠ {
  پەڵەکان.زیادبکە({ x: هەڕەمەکی(٠، ٥٠٠)، y: هەڕەمەکی(٠، ٣٢٠)، r: هەڕەمەکی(١، ٣)، خ: هەڕەمەکی(١، ٣)، ف: هەڕەمەکی(٠، ٣٦٠) })
}
گۆڕاو کات = ٠

یاریبکە(() => {
  کات += ١
  نەگۆڕ با = ماوسX() >= ٠ ? (ماوسX() - ٢٥٠) / ١٠٠ : ٠٫٣
  پاشبنەمابکە(ڕەنگی(١٠، ١٥، ٣٥))
  ڕەنگبکە(ڕەنگی(١٥، ٢٥، ٥٥))
  لاکێش(٠، ١٠٠، ٥٠٠، ١٠٠)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٠٠))
  بازنە(٤٠٠، ٦٠، ٢٥)
  ڕەنگبکە(ڕەنگی(١٠، ١٥، ٣٥))
  بازنە(٤١٠، ٥٢، ٢٣)

  // شاخ و ماڵەکان
  ڕەنگبکە(ڕەنگی(٢٠، ٣٠، ٦٠))
  سێگۆشە(٠، ٢٠٠، ١٥٠، ٨٠، ٣٠٠، ٢٠٠)
  سێگۆشە(١٥٠، ٢٠٠، ٣٢٠، ٩٠، ٥٠٠، ٢٠٠)
  ڕەنگبکە(ڕەنگی(٢٤٠، ٢٤٥، ٢٥٥))
  لاکێش(٠، ٢٤٠، ٥٠٠، ٨٠)
  ڕەنگبکە(ڕەنگی(٦٠، ٤٠، ٣٠))
  لاکێش(٨٠، ١٩٠، ٨٠، ٦٠)
  ڕەنگبکە("سوور")
  سێگۆشە(٧٠، ١٩٠، ١٧٠، ١٩٠، ١٢٠، ١٥٠)
  ڕەنگبکە("زەرد")
  لاکێش(٩٥، ٢١٠، ٢٠، ٢٠)؛ لاکێش(١٢٥، ٢١٠، ٢٠، ٢٠)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٩))
  بۆ هەر پ لە پەڵەکان {
    پ.y += پ.خ
    پ.x += با * پ.خ + سینۆس((کات + پ.ف) / ٢٠) * ٠٫٦
    ئەگەر پ.y > ٣٢٠ { پ.y = -٥؛ پ.x = هەڕەمەکی(٠، ٥٠٠) }
    ئەگەر پ.x > ٥٢٠ { پ.x = -١٠ }
    ئەگەر پ.x < -٢٠ { پ.x = ٥١٠ }
    بازنە(پ.x، پ.y، پ.r)
  }
})
