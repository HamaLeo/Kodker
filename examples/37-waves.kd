// 🌊 شەپۆل — چەند ڕیزێک شەپۆلی سینۆسی لەسەر یەک، لەگەڵ خۆرئاوابوون
قەبارە(٥٠٠، ٣٢٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٤
  // ئاسمان بە گرادیەنت
  بۆ i لە ٠ تا ٢٩ {
    ڕەنگبکە(ڕەنگی(٢٥٥ - i * ٤، ١٣٠ + i * ٢، ٥٠ + i * ٦))
    لاکێش(٠، i * ٥، ٥٠٠، ٦)
  }
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٤٠، ١٨٠))
  بازنە(٢٥٠، ١٦٠ + سینۆس(کات / ٣) * ٥، ٤٥)
  // شەپۆلەکان
  بۆ هەر ت لە [٠، ١، ٢، ٣، ٤] {
    ڕەنگبکە(ڕەنگی(٢٠ + ت * ١٠، ٦٠ + ت * ١٥، ١٣٠ + ت * ٢٠، ٠٫٨))
    بۆ x لە ٠ تا ٤٩ {
      نەگۆڕ y = ١٧٠ + ت * ٣٠ + سینۆس(x * ٠٫١٥ + کات * (١ + ت * ٠٫٣) + ت * ٢) * (٨ + ت * ٣)
      لاکێش(x * ١٠، y، ١١، ٣٢٠ - y)
    }
  }
})
