// 🔢 ڕیزکردن (Bubble Sort) — بیبینە چۆن ئەلگۆریتمێک ژمارەکان ڕیز دەکات. کلیک = تێکەڵکردنی نوێ
قەبارە(٤٦٠، ٣٠٠)
گۆڕاو ل = []
گۆڕاو i = ٠
گۆڕاو j = ٠
گۆڕاو بەراورد = ٠
گۆڕاو تەواو = هەڵە
گۆڕاو ڕاگرتن = ٠
گۆڕاو سەرەنج = ٠

کار تێکەڵ() {
  ل = []
  بۆ k لە ١ تا ٣٠ { ل.زیادبکە(k * ٨) }
  بۆ k لە ٢٩ تا ١ هەنگاو -١ {
    نەگۆڕ r = هەڕەمەکی(٠، k)
    نەگۆڕ t = ل[k]؛ ل[k] = ل[r]؛ ل[r] = t
  }
  i = ٠؛ j = ٠؛ بەراورد = ٠؛ تەواو = هەڵە؛ سەرەنج = ٠
}
تێکەڵ()

یاریبکە(() => {
  ئەگەر کلیککراوە() { تێکەڵ() }
  // هەر فریمێک ٣ بەراوردکردن
  بۆ گ لە ١ تا ٣ {
    ئەگەر نەک تەواو {
      ئەگەر ل[j] > ل[j + ١] { نەگۆڕ t = ل[j]؛ ل[j] = ل[j + ١]؛ ل[j + ١] = t }
      بەراورد += ١
      j += ١
      ئەگەر j >= ل.درێژی - ١ - i { j = ٠؛ i += ١ }
      ئەگەر i >= ل.درێژی - ١ { تەواو = ڕاست؛ ڕاگرتن = ١٢٠ }
    }
  }
  ئەگەر تەواو { سەرەنج = بچووکترین(٣٠، سەرەنج + ١)؛ ڕاگرتن -= ١؛ ئەگەر ڕاگرتن <= ٠ { تێکەڵ() } }

  پاشبنەمابکە(ڕەنگی(١٥، ٢٠، ٣٥))
  بۆ k لە ٠ تا ل.درێژی - ١ {
    ڕەنگبکە(تەواو ? (k < سەرەنج ? "سەوز" : "ئاسمانی") : (k == j یان k == j + ١ ? "سوور" : (k >= ل.درێژی - i ? "سەوز" : "ئاسمانی")))
    لاکێش(k * ١٥ + ٥، ٢٨٠ - ل[k]، ١٢، ل[k])
  }
  ڕەنگبکە("سپی")
  نووسین("بەراوردکردن: " + بەراورد، ١٠، ٢٥، ١٨)
  نووسین(تەواو ? "ڕیز کرا ✓" : "بەرەو ڕیزکردن...", ٣٢٠، ٢٥، ١٨)
})
