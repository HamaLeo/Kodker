// یاری: ئەستێرۆیید — چەپ/ڕاست بسووڕێ، سەرەوە بۆ هێز، بۆشایی بۆ گوللە. بەردەکان بتەقێنە و پێیان مەکەوە!
قەبارە(٥٠٠، ٤٠٠)
نەگۆڕ پان = ٥٠٠
نەگۆڕ بەرز = ٤٠٠
گۆڕاو x = ٢٥٠
گۆڕاو y = ٢٠٠
گۆڕاو گۆشە = ٠
گۆڕاو vx = ٠
گۆڕاو vy = ٠
گۆڕاو گوللەکان = []
گۆڕاو بەردەکان = []
گۆڕاو ئاگر = ٠
گۆڕاو ژیان = ٣
گۆڕاو خاڵ = ٠
گۆڕاو پارێزراو = ١٢٠
گۆڕاو قۆناغ = ١

کار بەردی_نوێ(قەبارە، bx، by) {
  نەگۆڕ g = هەڕەمەکی(٠، ٣٦٠) * پای / ١٨٠
  نەگۆڕ خ = هەڕەمەکی(١، ٣) * ٠٫٦
  بەردەکان.زیادبکە({ x: bx، y: by، vx: سینۆس(g) * خ، vy: -کۆسینۆس(g) * خ، قەبارە: قەبارە })
}

کار دەستپێکردن() {
  بەردەکان = []
  بۆ i لە ١ تا ٣ + قۆناغ {
    بەردی_نوێ(٣، هەڕەمەکی(٠، ١) == ٠ ? هەڕەمەکی(٠، ١٠٠) : هەڕەمەکی(٤٠٠، ٥٠٠)، هەڕەمەکی(٠، ٤٠٠))
  }
}
دەستپێکردن()

کار دەوری(n، سنوور_) { گەڕێنەوە ((n % سنوور_) + سنوور_) % سنوور_ }

یاریبکە(() => {
  ئاگر -= ١
  پارێزراو -= ١
  ئەگەر ژیان > ٠ {
    ئەگەر کلیل("چەپ") { گۆشە -= ٠٫١ }
    ئەگەر کلیل("ڕاست") { گۆشە += ٠٫١ }
    ئەگەر کلیل("سەرەوە") {
      vx += سینۆس(گۆشە) * ٠٫١٢
      vy -= کۆسینۆس(گۆشە) * ٠٫١٢
    }
    vx *= ٠٫٩٩؛ vy *= ٠٫٩٩
    x = دەوری(x + vx، پان)؛ y = دەوری(y + vy، بەرز)
    ئەگەر کلیل("بۆشایی") و ئاگر <= ٠ {
      گوللەکان.زیادبکە({ x: x + سینۆس(گۆشە) * ١٥، y: y - کۆسینۆس(گۆشە) * ١٥، vx: سینۆس(گۆشە) * ٧ + vx، vy: -کۆسینۆس(گۆشە) * ٧ + vy، ژیان: ٥٠ })
      ئاگر = ١٠
    }
  }

  بۆ هەر گ لە گوللەکان {
    گ.x = دەوری(گ.x + گ.vx، پان)؛ گ.y = دەوری(گ.y + گ.vy، بەرز)؛ گ.ژیان -= ١
  }
  بۆ هەر ب لە بەردەکان {
    ب.x = دەوری(ب.x + ب.vx، پان)؛ ب.y = دەوری(ب.y + ب.vy، بەرز)
    نەگۆڕ r = ب.قەبارە * ١٠
    بۆ هەر گ لە گوللەکان {
      ئەگەر دووری(گ.x، گ.y، ب.x، ب.y) < r { گ.ژیان = ٠؛ ب.مردووە = ڕاست؛ خاڵ += (٤ - ب.قەبارە) * ١٠ }
    }
    ئەگەر ژیان > ٠ و پارێزراو <= ٠ و دووری(x، y، ب.x، ب.y) < r + ٨ {
      ژیان -= ١؛ پارێزراو = ١٢٠؛ x = ٢٥٠؛ y = ٢٠٠؛ vx = ٠؛ vy = ٠
    }
  }
  بۆ هەر ب لە بەردەکان {
    ئەگەر ب.مردووە و ب.قەبارە > ١ {
      بەردی_نوێ(ب.قەبارە - ١، ب.x، ب.y)؛ بەردی_نوێ(ب.قەبارە - ١، ب.x، ب.y)
    }
  }
  بەردەکان = بەردەکان.پاڵاوتن(ب => نەک ب.مردووە)
  گوللەکان = گوللەکان.پاڵاوتن(گ => گ.ژیان > ٠)
  ئەگەر بەردەکان.درێژی == ٠ { قۆناغ += ١؛ دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(٥، ٥، ٢٠))
  ڕەنگبکە("زەرد")
  بۆ هەر گ لە گوللەکان { بازنە(گ.x، گ.y، ٢) }
  هێڵڕەنگبکە("سپی")
  ئەستووریبکە(٢)
  بۆ هەر ب لە بەردەکان { بازنەهێڵ(ب.x، ب.y، ب.قەبارە * ١٠) }
  ئەگەر ژیان > ٠ و (پارێزراو <= ٠ یان پارێزراو % ١٠ < ٥) {
    نەگۆڕ s = سینۆس(گۆشە)
    نەگۆڕ c = کۆسینۆس(گۆشە)
    ڕەنگبکە("ئاسمانی")
    سێگۆشە(x + s * ١٨، y - c * ١٨، x - c * ١٠ - s * ١٠، y - s * ١٠ + c * ١٠، x + c * ١٠ - s * ١٠، y + s * ١٠ + c * ١٠)
    ئەگەر کلیل("سەرەوە") {
      ڕەنگبکە("نارنجی")
      سێگۆشە(x - s * ٢٢ - c * ٤، y + c * ٢٢ - s * ٤، x - s * ٢٢ + c * ٤، y + c * ٢٢ + s * ٤، x - s * ٣٢، y + c * ٣٢)
    }
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٥، ٢٠)
  نووسین("❤ " + گەورەترین(ژیان، ٠) + "   قۆناغ " + قۆناغ، ٣٢٠، ٢٥، ١٨)
  ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٥٠٠، ٤٠٠)
    ڕەنگبکە("سپی")
    نووسین("کۆتایی! خاڵ: " + خاڵ، ١٥٠، ١٨٠، ٣٠)
    نووسین("کلیک = دووبارە", ١٩٠، ٢٢٠، ٢٠)
    ئەگەر کلیککراوە() { ژیان = ٣؛ خاڵ = ٠؛ قۆناغ = ١؛ پارێزراو = ١٢٠؛ دەستپێکردن() }
  }
})
