// یاری: ٢٠٤٨ — بە تیرەکان هەموو ژمارەکان بجووڵێنە. دوو ژمارەی وەک یەک تێکەڵ دەبن. بگەڕێ بۆ ٢٠٤٨!
قەبارە(٤٠٠، ٤٦٠)
گۆڕاو تەخت = []
گۆڕاو خاڵ = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو پێشوو = هەڵە

کار خانەیەکی_نوێ() {
  نەگۆڕ بەتاڵ = []
  بۆ i لە ٠ تا ١٥ { ئەگەر تەخت[i] == ٠ { بەتاڵ.زیادبکە(i) } }
  ئەگەر بەتاڵ.درێژی > ٠ { تەخت[بەتاڵ[هەڕەمەکی(٠، بەتاڵ.درێژی - ١)]] = هەڕەمەکی(١، ١٠) == ١٠ ? ٤ : ٢ }
}

کار دەستپێکردن() {
  تەخت = []
  بۆ i لە ١ تا ١٦ { تەخت.زیادبکە(٠) }
  خاڵ = ٠؛ مردووە = هەڵە
  خانەیەکی_نوێ()؛ خانەیەکی_نوێ()
}
دەستپێکردن()

// ئیندێکسەکانی هەر هێڵێک، لە لای دیوارەوە دەست پێدەکات: ئاڕاستە ٠ چەپ، ١ ڕاست، ٢ سەرەوە، ٣ خوارەوە
کار هێڵ(ئا، k) {
  ئەگەر ئا == ٠ { گەڕێنەوە [k * ٤، k * ٤ + ١، k * ٤ + ٢، k * ٤ + ٣] }
  ئەگەر ئا == ١ { گەڕێنەوە [k * ٤ + ٣، k * ٤ + ٢، k * ٤ + ١، k * ٤] }
  ئەگەر ئا == ٢ { گەڕێنەوە [k، k + ٤، k + ٨، k + ١٢] }
  گەڕێنەوە [k + ١٢، k + ٨، k + ٤، k]
}

کار بجووڵێنە(ئا) {
  گۆڕاو گۆڕدرا = هەڵە
  بۆ k لە ٠ تا ٣ {
    نەگۆڕ ن = هێڵ(ئا، k)
    نەگۆڕ نرخەکان = ن.نەخشە(i => تەخت[i]).پاڵاوتن(v => v > ٠)
    نەگۆڕ ئەنجام = []
    گۆڕاو j = ٠
    هەتا j < نرخەکان.درێژی {
      ئەگەر j + ١ < نرخەکان.درێژی و نرخەکان[j] == نرخەکان[j + ١] {
        ئەنجام.زیادبکە(نرخەکان[j] * ٢)؛ خاڵ += نرخەکان[j] * ٢؛ j += ٢
      } ئەگەرنا { ئەنجام.زیادبکە(نرخەکان[j])؛ j += ١ }
    }
    هەتا ئەنجام.درێژی < ٤ { ئەنجام.زیادبکە(٠) }
    بۆ t لە ٠ تا ٣ {
      ئەگەر تەخت[ن[t]] != ئەنجام[t] { گۆڕدرا = ڕاست }
      تەخت[ن[t]] = ئەنجام[t]
    }
  }
  ئەگەر گۆڕدرا { خانەیەکی_نوێ() }
}

کار جووڵەماوە() {
  بۆ i لە ٠ تا ١٥ {
    ئەگەر تەخت[i] == ٠ { گەڕێنەوە ڕاست }
    ئەگەر i % ٤ < ٣ و تەخت[i] == تەخت[i + ١] { گەڕێنەوە ڕاست }
    ئەگەر i < ١٢ و تەخت[i] == تەخت[i + ٤] { گەڕێنەوە ڕاست }
  }
  گەڕێنەوە هەڵە
}

یاریبکە(() => {
  نەگۆڕ ئا = کلیل("چەپ") ? ٠ : کلیل("ڕاست") ? ١ : کلیل("سەرەوە") ? ٢ : کلیل("خوارەوە") ? ٣ : -١
  ئەگەر ئا >= ٠ و نەک پێشوو و نەک مردووە {
    بجووڵێنە(ئا)
    مردووە = نەک جووڵەماوە()
  }
  پێشوو = ئا >= ٠
  ئەگەر مردووە و کلیککراوە() { دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(٢٥٠، ٢٤٨، ٢٣٩))
  ڕەنگبکە(ڕەنگی(١٨٧، ١٧٣، ١٦٠))
  لاکێش(٨، ٦٨، ٣٨٤، ٣٨٤)
  بۆ i لە ٠ تا ١٥ {
    نەگۆڕ v = تەخت[i]
    نەگۆڕ x = (i % ٤) * ٩٦ + ١٦
    نەگۆڕ y = خوارکە(i / ٤) * ٩٦ + ٧٦
    گۆڕاو ئاست = ٠
    گۆڕاو n = v
    هەتا n > ١ { n = n / ٢؛ ئاست += ١ }
    ڕەنگبکە(v == ٠ ? ڕەنگی(٢٠٥، ١٩٣، ١٨٠) : پەلکەزێڕینە(٤٠ + ئاست * ٢٥))
    لاکێش(x، y، ٨٨، ٨٨)
    ئەگەر v > ٠ {
      ڕەنگبکە("سپی")
      نووسین(v، x + (v < ١٠ ? ٣٢ : v < ١٠٠ ? ٢٢ : v < ١٠٠٠ ? ١٢ : ٤)، y + ٥٨، v < ١٠٠٠ ? ٣٢ : ٢٤)
    }
  }
  ڕەنگبکە(ڕەنگی(١٢٠، ١١٠، ١٠٠))
  نووسین("٢٠٤٨", ١٦، ٥٠، ٤٠)
  نووسین("خاڵ: " + خاڵ، ٢٤٠، ٥٠، ٢٤)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٧))؛ لاکێش(٨، ٦٨، ٣٨٤، ٣٨٤)
    ڕەنگبکە("ڕەش")
    نووسین("کۆتایی! کلیک = دووبارە", ٦٠، ٢٦٠، ٢٨)
  }
})
