// یاری: نیشتنەوە لەسەر مانگ 🚀 — سەرەوە = موشەکی سەرەوە، چەپ/ڕاست = موشەکی لاتەنیشت. بە نەرمی لەسەر پەڕەی سەوز بنیشەوە
قەبارە(٤٠٠، ٥٠٠)
گۆڕاو x = ٢٠٠
گۆڕاو y = ٦٠
گۆڕاو vx = هەڕەمەکی(-١، ١)
گۆڕاو vy = ٠
گۆڕاو سووتەمەنی = ٣٠٠
گۆڕاو دۆخ = "فڕین"        // فڕین، نیشتنەوە، تێکشکان
گۆڕاو پەڕە = ١٤٠
گۆڕاو خاڵ = ٠
گۆڕاو کات = ٠
نەگۆڕ ئەستێرەکان = []
بۆ i لە ١ تا ٦٠ { ئەستێرەکان.زیادبکە({ x: هەڕەمەکی(٠، ٤٠٠)، y: هەڕەمەکی(٠، ٤٠٠) }) }

کار نوێکردنەوە() {
  x = ٢٠٠؛ y = ٦٠؛ vx = هەڕەمەکی(-١، ١)؛ vy = ٠؛ سووتەمەنی = ٣٠٠؛ دۆخ = "فڕین"
  پەڕە = هەڕەمەکی(٣٠، ٢٦٠)
}

یاریبکە(() => {
  کات += ١
  گۆڕاو هێز = هەڵە
  ئەگەر دۆخ == "فڕین" {
    vy += ٠٫٠٥
    ئەگەر سووتەمەنی > ٠ {
      ئەگەر کلیل("سەرەوە") { vy -= ٠٫١٦؛ سووتەمەنی -= ١؛ هێز = ڕاست }
      ئەگەر کلیل("چەپ") { vx -= ٠٫٠٧؛ سووتەمەنی -= ٠٫٥ }
      ئەگەر کلیل("ڕاست") { vx += ٠٫٠٧؛ سووتەمەنی -= ٠٫٥ }
    }
    x += vx؛ y += vy
    x = سنوور(x، ٠، ٤٠٠)
    ئەگەر y < ٠ { y = ٠؛ vy = گەورەترین(vy، ٠) }
    ئەگەر y >= ٤٣٥ {
      y = ٤٣٥
      نەگۆڕ لەسەرپەڕە = x > پەڕە و x < پەڕە + ١٠٠
      ئەگەر لەسەرپەڕە و vy < ٢ و ڕەها(vx) < ١٫٥ {
        دۆخ = "نیشتنەوە"
        خاڵ += ١٠٠ + خوارکە(سووتەمەنی / ٣)
      } ئەگەرنا { دۆخ = "تێکشکان" }
    }
  } ئەگەرنا ئەگەر کلیککراوە() { نوێکردنەوە() }

  پاشبنەمابکە(ڕەنگی(٥، ٥، ٢٥))
  ڕەنگبکە("سپی")
  بۆ هەر ئ لە ئەستێرەکان { بازنە(ئ.x، ئ.y، ١) }
  ڕەنگبکە(ڕەنگی(١٢٠، ١٢٠، ١٣٠))
  سێگۆشە(٠، ٤٦٠، ٨٠، ٤٤٥، ١٦٠، ٤٦٠)
  لاکێش(٠، ٤٦٠، ٤٠٠، ٤٠)
  سێگۆشە(٢٨٠، ٤٦٠، ٣٤٠، ٤٣٠، ٤٠٠، ٤٦٠)
  ڕەنگبکە("سەوز")
  لاکێش(پەڕە، ٤٥٦، ١٠٠، ٨)
  // ماڵی مانگ
  ڕەنگبکە("سپی")
  لاکێش(x - ١٠، y - ١٢، ٢٠، ٢٠)
  سێگۆشە(x - ١٠، y - ١٢، x + ١٠، y - ١٢، x، y - ٢٨)
  ڕەنگبکە("ئاسمانی")
  بازنە(x، y - ٣، ٥)
  ڕەنگبکە(ڕەنگی(١٨٠، ١٨٠، ١٨٠))
  لاکێش(x - ١٥، y + ٨، ٣، ١٠)؛ لاکێش(x + ١٢، y + ٨، ٣، ١٠)
  ئەگەر هێز {
    ڕەنگبکە(کات % ٤ < ٢ ? "نارنجی" : "زەرد")
    سێگۆشە(x - ٦، y + ٨، x + ٦، y + ٨، x، y + ٢٦ + هەڕەمەکی(٠، ٨))
  }
  ڕەنگبکە("سپی")
  نووسین("سووتەمەنی: " + خوارکە(گەورەترین(سووتەمەنی، ٠))، ١٠، ٢٥، ١٨)
  نووسین("خێرایی: " + vy.دەهەک(١)، ١٠، ٤٨، ١٨)
  نووسین("خاڵ: " + خاڵ، ٣٠٠، ٢٥، ١٨)
  ئەگەر دۆخ == "نیشتنەوە" { نووسین("نیشتیتەوە! 🎉 کلیک = دووبارە", ٦٠، ٢٣٠، ٢٤) }
  ئەگەر دۆخ == "تێکشکان" { نووسین("💥 تێکشکا! کلیک = دووبارە", ٧٠، ٢٣٠، ٢٤) }
})
