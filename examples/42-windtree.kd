// 🌳 درەختی بای — درەختێک کە لە با دەلەرێتەوە. ماوس بجووڵێنە بۆ گۆڕینی بای
قەبارە(٤٥٠، ٣٥٠)
گۆڕاو کات = ٠

کار لق(x، y، درێژی، گۆشە، ئاست، با) {
  نەگۆڕ x٢ = x + سینۆس(گۆشە) * درێژی
  نەگۆڕ y٢ = y - کۆسینۆس(گۆشە) * درێژی
  ئەستووریبکە(ئاست * ٠٫٨ + ٠٫٥)
  هێڵڕەنگبکە(ئاست > ٣ ? ڕەنگی(١٠٠، ٦٥، ٣٥) : ڕەنگی(٤٠، ١٦٠ - ئاست * ١٠، ٦٠))
  هێڵ(x، y، x٢، y٢)
  ئەگەر ئاست > ٠ {
    نەگۆڕ لەرین = سینۆس(کات * ٢ + ئاست) * ٠٫٠٦ * با
    لق(x٢، y٢، درێژی * ٠٫٧٦، گۆشە - ٠٫٤٥ + لەرین، ئاست - ١، با)
    لق(x٢، y٢، درێژی * ٠٫٧٦، گۆشە + ٠٫٣٥ + لەرین، ئاست - ١، با)
  }
}

یاریبکە(() => {
  کات += ٠٫٠٢
  نەگۆڕ با = ماوسX() >= ٠ ? ٠٫٥ + ماوسX() / ١٠٠ : ٢
  پاشبنەمابکە(ڕەنگی(٢٢٠، ٢٣٥، ٢٥٥))
  ڕەنگبکە(ڕەنگی(٩٠، ١٦٠، ٨٠))
  لاکێش(٠، ٣٢٠، ٤٥٠، ٣٠)
  لق(٢٢٥، ٣٢٠، ٧٠، سینۆس(کات) * ٠٫٠٤ * با، ٩، با)
})
