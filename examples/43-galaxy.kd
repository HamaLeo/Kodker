// 🌌 کەهکەشان — ئەستێرەکانی لە بازنەی لێکدراودا دەسووڕێنەوە. ماوس بجووڵێنە بۆ گۆڕینی شێوە
قەبارە(٤٥٠، ٤٥٠)
نەگۆڕ ئەستێرەکان = []
بۆ i لە ٠ تا ٥٠٠ {
  ئەستێرەکان.زیادبکە({ دووری: هەڕەمەکی(٥، ٢٠٠)، شانە: هەڕەمەکی(٠، ٣)، لادان: هەڕەمەکی(-١٥، ١٥)، قەبارە: هەڕەمەکی(١، ٣)، ڕەنگ: هەڕەمەکی(٢٠٠، ٢٨٠) })
}
گۆڕاو کات = ٠

یاریبکە(() => {
  کات += ٠٫٥
  نەگۆڕ پێچ = ماوسX() >= ٠ ? ماوسX() / ١٠٠٠ + ٠٫٠٠٥ : ٠٫٠١٥
  پاشبنەمابکە(ڕەنگی(٣، ٣، ١٢))
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٠٠، ١٠٠، ٠٫٣))
  بازنە(٢٢٥، ٢٢٥، ٣٥)
  ڕەنگبکە(ڕەنگی(٢٥٥، ٢٣٠، ١٦٠، ٠٫٦))
  بازنە(٢٢٥، ٢٢٥، ١٥)
  بۆ هەر ئ لە ئەستێرەکان {
    نەگۆڕ g = ئ.دووری * پێچ * ٣ + ئ.شانە * (٢ * پای / ٤) + کات * ٠٫٠٢ * (٢٣٠ / (ئ.دووری + ٣٠))
    نەگۆڕ x = ٢٢٥ + کۆسینۆس(g) * ئ.دووری + ئ.لادان
    نەگۆڕ y = ٢٢٥ + سینۆس(g) * ئ.دووری * ٠٫٧ + ئ.لادان * ٠٫٥
    ڕەنگبکە(پەلکەزێڕینە(ئ.ڕەنگ، ٠٫٧))
    بازنە(x، y، ئ.قەبارە * ٠٫٦)
  }
})
