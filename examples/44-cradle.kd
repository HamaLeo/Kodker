// ⚖ بیشکەی نیوتن — تۆپی یەکەم و کۆتایی بە نۆبە دەجووڵێن و تۆپەکانی ناوەڕاست دەمێننەوە
قەبارە(٤٠٠، ٣٠٠)
گۆڕاو کات = ٠

یاریبکە(() => {
  کات += ٠٫٠٤
  پاشبنەمابکە(ڕەنگی(٣٠، ٣٥، ٥٥))
  ڕەنگبکە(ڕەنگی(٨٠، ٦٠، ٤٠))
  لاکێش(٤٠، ٣٠، ٣٢٠، ١٠)
  لاکێش(٣٥، ٣٠، ١٠، ٢٤٠)؛ لاکێش(٣٥٥، ٣٠، ١٠، ٢٤٠)
  لاکێش(٢٠، ٢٦٠، ٣٦٠، ١٢)
  نەگۆڕ s = سینۆس(کات)
  بۆ i لە ٠ تا ٤ {
    گۆڕاو گۆشە = ٠
    ئەگەر i == ٠ و s > ٠ { گۆشە = -s * ٠٫٨ }
    ئەگەر i == ٤ و s < ٠ { گۆشە = -s * ٠٫٨ }
    نەگۆڕ ڕ = ١٥٠
    نەگۆڕ ڕووی = ٨٠ + i * ٤٨
    نەگۆڕ bx = ڕووی + سینۆس(گۆشە) * ڕ
    نەگۆڕ by = ٤٠ + کۆسینۆس(گۆشە) * ڕ
    هێڵڕەنگبکە(ڕەنگی(١٨٠، ١٨٠، ١٩٠))
    ئەستووریبکە(١٫٥)
    هێڵ(ڕووی - ٨، ٤٠، bx، by)؛ هێڵ(ڕووی + ٨، ٤٠، bx، by)
    ڕەنگبکە(ڕەنگی(٢٢٠، ٢٢٠، ٢٣٠))
    بازنە(bx، by، ٢٣)
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٤))
    بازنە(bx - ٧، by - ٨، ٧)
  }
})
