// یاری: تێتریس — ← → بجووڵێنە، ↑ بسووڕێنە، ↓ خێراتر، بۆشایی = دەستبەجێ دابکەوێت. ڕیزی پڕ دەسڕێتەوە!
قەبارە(٣٤٠، ٤٨٠)
نەگۆڕ شێوەکان = [
  [[٠، ٠]، [١، ٠]، [٢، ٠]، [٣، ٠]]،
  [[٠، ٠]، [١، ٠]، [٠، ١]، [١، ١]]،
  [[٠، ٠]، [١، ٠]، [٢، ٠]، [١، ١]]،
  [[١، ٠]، [٢، ٠]، [٠، ١]، [١، ١]]،
  [[٠، ٠]، [١، ٠]، [١، ١]، [٢، ١]]،
  [[٠، ٠]، [٠، ١]، [١، ١]، [٢، ١]]،
  [[٢، ٠]، [٠، ١]، [١، ١]، [٢، ١]]،
]
گۆڕاو تەخت = []
گۆڕاو پارچە = هیچ
گۆڕاو دواتر = هەڕەمەکی(٠، ٦)
گۆڕاو خاڵ = ٠
گۆڕاو ڕیزەکان = ٠
گۆڕاو کات = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو پێشووسەرەوە = هەڵە
گۆڕاو پێشووبۆشایی = هەڵە

کار تەختی_نوێ() {
  تەخت = []
  بۆ y لە ١ تا ٢٠ {
    نەگۆڕ ڕ = []
    بۆ x لە ١ تا ١٠ { ڕ.زیادبکە(٠) }
    تەخت.زیادبکە(ڕ)
  }
}

کار پارچەی_نوێ() {
  پارچە = { خانەکان: شێوەکان[دواتر]، x: ٣، y: ٠، ڕەنگ: دواتر * ٥٠ + ٢٠ }
  دواتر = هەڕەمەکی(٠، ٦)
  ئەگەر نەک دەگونجێت(پارچە.خانەکان، پارچە.x، پارچە.y) { مردووە = ڕاست }
}

کار دەگونجێت(خانەکان، px، py) {
  بۆ هەر خ لە خانەکان {
    نەگۆڕ x = px + خ[٠]
    نەگۆڕ y = py + خ[١]
    ئەگەر x < ٠ یان x > ٩ یان y > ١٩ { گەڕێنەوە هەڵە }
    ئەگەر y >= ٠ و تەخت[y][x] != ٠ { گەڕێنەوە هەڵە }
  }
  گەڕێنەوە ڕاست
}

کار دابنێ() {
  بۆ هەر خ لە پارچە.خانەکان { تەخت[پارچە.y + خ[١]][پارچە.x + خ[٠]] = پارچە.ڕەنگ }
  نەگۆڕ ماوە = تەخت.پاڵاوتن(ڕ => ڕ.پاڵاوتن(v => v == ٠).درێژی > ٠)
  نەگۆڕ سڕدراو = ٢٠ - ماوە.درێژی
  گۆڕاو تەختی_ماوە = ماوە
  هەتا تەختی_ماوە.درێژی < ٢٠ {
    نەگۆڕ بەتاڵ = []
    بۆ x لە ١ تا ١٠ { بەتاڵ.زیادبکە(٠) }
    تەختی_ماوە = [بەتاڵ، ...تەختی_ماوە]
  }
  تەخت = تەختی_ماوە
  ڕیزەکان += سڕدراو
  خاڵ += [٠، ١٠٠، ٣٠٠، ٥٠٠، ٨٠٠][سڕدراو]
  پارچەی_نوێ()
}

کار بسووڕێنە() {
  نەگۆڕ س = پارچە.خانەکان.نەخشە(خ => [-خ[١]، خ[٠]])
  نەگۆڕ کەمX = گەورەترین(...س.نەخشە(خ => -خ[٠]))
  نەگۆڕ کەمY = گەورەترین(...س.نەخشە(خ => -خ[١]))
  نەگۆڕ ڕاستکراو = س.نەخشە(خ => [خ[٠] + کەمX، خ[١] + کەمY])
  بۆ هەر ڕاگوێزان لە [٠، -١، ١] {
    ئەگەر دەگونجێت(ڕاستکراو، پارچە.x + ڕاگوێزان، پارچە.y) {
      پارچە.خانەکان = ڕاستکراو؛ پارچە.x += ڕاگوێزان
      گەڕێنەوە
    }
  }
}

تەختی_نوێ()
پارچەی_نوێ()

یاریبکە(() => {
  کات += ١
  نەگۆڕ بۆشایی = کلیل("بۆشایی")
  نەگۆڕ سەرەوە = کلیل("سەرەوە")
  ئەگەر مردووە {
    ئەگەر کلیککراوە() { تەختی_نوێ()؛ خاڵ = ٠؛ ڕیزەکان = ٠؛ مردووە = هەڵە؛ پارچەی_نوێ() }
  } ئەگەرنا {
    ئەگەر کات % ٥ == ٠ {
      ئەگەر کلیل("چەپ") و دەگونجێت(پارچە.خانەکان، پارچە.x - ١، پارچە.y) { پارچە.x -= ١ }
      ئەگەر کلیل("ڕاست") و دەگونجێت(پارچە.خانەکان، پارچە.x + ١، پارچە.y) { پارچە.x += ١ }
    }
    ئەگەر سەرەوە و نەک پێشووسەرەوە { بسووڕێنە() }
    ئەگەر بۆشایی و نەک پێشووبۆشایی {
      هەتا دەگونجێت(پارچە.خانەکان، پارچە.x، پارچە.y + ١) { پارچە.y += ١ }
      دابنێ()
    } ئەگەرنا {
      نەگۆڕ خێرایی = خوارکە(گەورەترین(٦، ٣٠ - ڕیزەکان * ٢))
      ئەگەر کات % (کلیل("خوارەوە") ? ٢ : خێرایی) == ٠ {
        ئەگەر دەگونجێت(پارچە.خانەکان، پارچە.x، پارچە.y + ١) { پارچە.y += ١ } ئەگەرنا { دابنێ() }
      }
    }
  }
  پێشووسەرەوە = سەرەوە
  پێشووبۆشایی = بۆشایی

  پاشبنەمابکە(ڕەنگی(١٥، ٢٠، ٣٥))
  ڕەنگبکە(ڕەنگی(٢٥، ٣٠، ٥٠))
  لاکێش(٠، ٠، ٢٤٠، ٤٨٠)
  بۆ y لە ٠ تا ١٩ {
    بۆ x لە ٠ تا ٩ {
      ئەگەر تەخت[y][x] != ٠ {
        ڕەنگبکە(پەلکەزێڕینە(تەخت[y][x]))
        لاکێش(x * ٢٤ + ١، y * ٢٤ + ١، ٢٢، ٢٢)
      }
    }
  }
  ئەگەر پارچە و نەک مردووە {
    ڕەنگبکە(پەلکەزێڕینە(پارچە.ڕەنگ))
    بۆ هەر خ لە پارچە.خانەکان { لاکێش((پارچە.x + خ[٠]) * ٢٤ + ١، (پارچە.y + خ[١]) * ٢٤ + ١، ٢٢، ٢٢) }
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ", ٢٥٥، ٣٥، ١٨)
  نووسین(خاڵ، ٢٥٥، ٦٠، ٢٤)
  نووسین("ڕیز", ٢٥٥، ١٠٠، ١٨)
  نووسین(ڕیزەکان، ٢٥٥، ١٢٥، ٢٤)
  نووسین("دواتر", ٢٥٥، ١٧٠، ١٨)
  ڕەنگبکە(پەلکەزێڕینە(دواتر * ٥٠ + ٢٠))
  بۆ هەر خ لە شێوەکان[دواتر] { لاکێش(٢٥٥ + خ[٠] * ١٨، ١٩٠ + خ[١] * ١٨، ١٦، ١٦) }
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٢٤٠، ٤٨٠)
    ڕەنگبکە("سپی")
    نووسین("تەواو بوو!", ٥٠، ٢١٠، ٣٠)
    نووسین("کلیک = دووبارە", ٥٠، ٢٥٠، ٢٠)
  }
})
