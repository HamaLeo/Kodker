// یاری: بۆقە — بە تیرەکان لە ڕێگا و ڕووباردا بپەڕەوە بۆ سەرەوە. ئوتومبێلەکان مەکەوە، لەسەر داری ڕووبار بمێنەوە!
قەبارە(٤٠٠، ٤٧٠)
// هەر هێڵێک: ڕیز، خێرایی، پانی شتەکان، جۆر ("ئوتومبێل" یان "دار")
نەگۆڕ هێڵەکان = [
  { ڕیز: ١، خ: ١٫٢، پان: ١٢٠، جۆر: "دار" }،
  { ڕیز: ٢، خ: -٢، پان: ٨٠، جۆر: "دار" }،
  { ڕیز: ٣، خ: ١٫٦، پان: ١٠٠، جۆر: "دار" }،
  { ڕیز: ٥، خ: -٢٫٥، پان: ٥٠، جۆر: "ئوتومبێل" }،
  { ڕیز: ٦، خ: ٣، پان: ٦٠، جۆر: "ئوتومبێل" }،
  { ڕیز: ٧، خ: -١٫٨، پان: ٥٠، جۆر: "ئوتومبێل" }،
  { ڕیز: ٨، خ: ٣٫٥، پان: ٦٠، جۆر: "ئوتومبێل" }،
]
نەگۆڕ شتەکان = []
هێڵەکان.بۆهەریەک((ه، i) => {
  بۆ k لە ٠ تا ٢ { شتەکان.زیادبکە({ هێڵ: ه، x: k * ١٦٠ + i * ٣٧ }) }
})
گۆڕاو بۆقە = { x: ١٨٠، ڕیز: ١٠ }
گۆڕاو ژیان = ٣
گۆڕاو خاڵ = ٠
گۆڕاو پێشوو = هەڵە
گۆڕاو مردووە = هەڵە

کار دووبارە() { بۆقە = { x: ١٨٠، ڕیز: ١٠ } }
کار مردن() { ژیان -= ١؛ دووبارە() }

یاریبکە(() => {
  نەگۆڕ ئا = کلیل("چەپ") ? "چ" : کلیل("ڕاست") ? "ڕ" : کلیل("سەرەوە") ? "س" : کلیل("خوارەوە") ? "خ" : ""
  ئەگەر ژیان > ٠ {
    ئەگەر ئا != "" و نەک پێشوو {
      ئەگەر ئا == "چ" { بۆقە.x -= ٤٠ }
      ئەگەر ئا == "ڕ" { بۆقە.x += ٤٠ }
      ئەگەر ئا == "س" { بۆقە.ڕیز -= ١ }
      ئەگەر ئا == "خ" { بۆقە.ڕیز = بچووکترین(١٠، بۆقە.ڕیز + ١) }
    }
    بۆ هەر ش لە شتەکان {
      ش.x += ش.هێڵ.خ
      ئەگەر ش.هێڵ.خ > ٠ و ش.x > ٤٠٠ { ش.x = -ش.هێڵ.پان }
      ئەگەر ش.هێڵ.خ < ٠ و ش.x < -ش.هێڵ.پان { ش.x = ٤٠٠ }
    }
    نەگۆڕ لەسەرداری = []
    بۆ هەر ش لە شتەکان {
      ئەگەر ش.هێڵ.ڕیز == بۆقە.ڕیز {
        نەگۆڕ بۆقەناوەند = بۆقە.x + ١٥
        ئەگەر بۆقەناوەند > ش.x و بۆقەناوەند < ش.x + ش.هێڵ.پان {
          ئەگەر ش.هێڵ.جۆر == "ئوتومبێل" { مردن() } ئەگەرنا { لەسەرداری.زیادبکە(ش) }
        }
      }
    }
    ئەگەر بۆقە.ڕیز >= ١ و بۆقە.ڕیز <= ٣ {
      ئەگەر لەسەرداری.درێژی > ٠ { بۆقە.x += لەسەرداری[٠].هێڵ.خ } ئەگەرنا { مردن() }
    }
    ئەگەر بۆقە.x < ٠ یان بۆقە.x > ٣٧٠ { بۆقە.x = سنوور(بۆقە.x، ٠، ٣٧٠)؛ ئەگەر بۆقە.ڕیز >= ١ و بۆقە.ڕیز <= ٣ { مردن() } }
    ئەگەر بۆقە.ڕیز == ٠ { خاڵ += ١٠؛ دووبارە() }
  } ئەگەرنا ئەگەر کلیککراوە() { ژیان = ٣؛ خاڵ = ٠؛ دووبارە() }
  پێشوو = ئا != ""

  پاشبنەمابکە(ڕەنگی(٢٠، ٤٠، ٢٥))
  // ڕووبار
  ڕەنگبکە(ڕەنگی(٣٠، ٨٠، ١٨٠))
  لاکێش(٠، ٧٠، ٤٠٠، ١٢٠)
  // ڕێگا
  ڕەنگبکە(ڕەنگی(٤٠، ٤٠، ٤٨))
  لاکێش(٠، ٢٣٠، ٤٠٠، ١٦٠)
  ڕەنگبکە(ڕەنگی(٩٠، ١٧٠، ٨٠))
  لاکێش(٠، ٣٠، ٤٠٠، ٤٠)؛ لاکێش(٠، ١٩٠، ٤٠٠، ٤٠)؛ لاکێش(٠، ٤٣٠، ٤٠٠، ٤٠)
  بۆ هەر ش لە شتەکان {
    نەگۆڕ y = ش.هێڵ.ڕیز * ٤٠ + ٣٠
    ئەگەر ش.هێڵ.جۆر == "دار" {
      ڕەنگبکە("قاوەیی")
      لاکێش(ش.x، y + ٤، ش.هێڵ.پان، ٣٢)
    } ئەگەرنا {
      ڕەنگبکە(ش.هێڵ.خ > ٠ ? "سوور" : "نارنجی")
      لاکێش(ش.x، y + ٦، ش.هێڵ.پان، ٢٨)
      ڕەنگبکە("سپی")
      لاکێش(ش.x + ش.هێڵ.پان * ٠٫٦، y + ١٠، ش.هێڵ.پان * ٠٫٢، ٢٠)
    }
  }
  ئەگەر ژیان > ٠ {
    نەگۆڕ y = بۆقە.ڕیز * ٤٠ + ٣٠
    ڕەنگبکە("سەوز")
    لاکێش(بۆقە.x + ٤، y + ٦، ٢٢، ٢٨)
    بازنە(بۆقە.x + ١٥، y + ٨، ٨)
    ڕەنگبکە("سپی")
    بازنە(بۆقە.x + ١١، y + ٥، ٣)؛ بازنە(بۆقە.x + ٢٠، y + ٥، ٣)
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٢، ١٨)
  نووسین("❤ " + ژیان، ٣٤٠، ٢٢، ١٨)
  ئەگەر ژیان <= ٠ {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٤٠٠، ٤٧٠)
    ڕەنگبکە("سپی")
    نووسین("تەواو بوو! خاڵ: " + خاڵ، ١٠٠، ٢٢٠، ٢٦)
    نووسین("کلیک = دووبارە", ١٣٠، ٢٦٠، ٢٠)
  }
})
