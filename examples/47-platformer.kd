// یاری: سکەکان 🪙 — بە ← → بجووڵێ و بە ↑ یان بۆشایی باز بدە. هەموو سکەکان کۆبکەرەوە و لە دوژمنە سوورەکە ڕابکە!
قەبارە(٥٠٠، ٣٢٠)
نەگۆڕ پلاتفۆرمەکان = [[٠، ٣٠٠، ٥٠٠، ٢٠]، [٦٠، ٢٣٠، ١٢٠، ١٢]، [٢٣٠، ١٨٠، ١٢٠، ١٢]، [٤٠٠، ١٣٠، ١٠٠، ١٢]، [١٠٠، ١٠٠، ١٠٠، ١٢]]
نەگۆڕ سکەکان_ئەسڵی = [[١٠٠، ٢٠٠]، [١٥٠، ٢٠٠]، [٢٧٠، ١٥٠]، [٣٠٠، ١٥٠]، [٤٤٠، ١٠٠]، [١٣٠، ٧٠]، [١٦٠، ٧٠]، [٤٠٠، ٢٨٠]]
گۆڕاو سکەکان = []
گۆڕاو x = ٣٠
گۆڕاو y = ٢٥٠
گۆڕاو vx = ٠
گۆڕاو vy = ٠
گۆڕاو لەسەرزەوی = هەڵە
گۆڕاو دوژمن = ٢٠٠
گۆڕاو دوژمنخ = ١٫٥
گۆڕاو خاڵ = ٠
گۆڕاو بردرا = هەڵە

کار نوێکردنەوە() {
  سکەکان = سکەکان_ئەسڵی.نەخشە(س => [س[٠]، س[١]])
  x = ٣٠؛ y = ٢٥٠؛ vx = ٠؛ vy = ٠؛ خاڵ = ٠؛ بردرا = هەڵە
}
نوێکردنەوە()

یاریبکە(() => {
  ئەگەر نەک بردرا {
    ئەگەر کلیل("چەپ") { vx -= ٠٫٥ }
    ئەگەر کلیل("ڕاست") { vx += ٠٫٥ }
    vx *= ٠٫٨٥
    ئەگەر (کلیل("سەرەوە") یان کلیل("بۆشایی")) و لەسەرزەوی { vy = -١١ }
    vy += ٠٫٦
    x += vx
    نەگۆڕ پێشوویبن = y + ٢٠
    y += vy
    x = سنوور(x، ٠، ٤٨٠)
    لەسەرزەوی = هەڵە
    بۆ هەر پ لە پلاتفۆرمەکان {
      ئەگەر vy >= ٠ و پێشوویبن <= پ[١] + ٢ و y + ٢٠ >= پ[١] و x + ١٦ > پ[٠] و x < پ[٠] + پ[٢] {
        y = پ[١] - ٢٠؛ vy = ٠؛ لەسەرزەوی = ڕاست
      }
    }
    // دوژمن
    دوژمن += دوژمنخ
    ئەگەر دوژمن > ٣٨٠ یان دوژمن < ٢٠٠ { دوژمنخ = -دوژمنخ }
    ئەگەر دووری(x + ٨، y + ١٠، دوژمن + ١٠، ٢٩٠) < ٢٢ { نوێکردنەوە() }
    // سکەکان
    نەگۆڕ ماونەتەوە = []
    بۆ هەر س لە سکەکان {
      ئەگەر دووری(x + ٨، y + ١٠، س[٠]، س[١]) < ١٨ { خاڵ += ١ } ئەگەرنا { ماونەتەوە.زیادبکە(س) }
    }
    سکەکان = ماونەتەوە
    ئەگەر سکەکان.درێژی == ٠ { بردرا = ڕاست }
  } ئەگەرنا ئەگەر کلیککراوە() { نوێکردنەوە() }

  پاشبنەمابکە(ڕەنگی(٩٠، ١٧٠، ٢٥٥))
  ڕەنگبکە("سپی")
  بازنە(٧٠، ٦٠، ٢٠)؛ بازنە(٩٠، ٥٥، ٢٥)؛ بازنە(٤١٠، ٤٠، ٢٠)؛ بازنە(٤٣٠، ٣٦، ٢٤)
  بۆ هەر پ لە پلاتفۆرمەکان {
    ڕەنگبکە(ڕەنگی(٩٠، ٦٠، ٣٥))
    لاکێش(پ[٠]، پ[١]، پ[٢]، پ[٣])
    ڕەنگبکە(ڕەنگی(٦٠، ١٧٠، ٦٠))
    لاکێش(پ[٠]، پ[١]، پ[٢]، ٥)
  }
  ڕەنگبکە("زەرد")
  بۆ هەر س لە سکەکان { بازنە(س[٠]، س[١]، ٩) }
  ڕەنگبکە(ڕەنگی(٢٠٠، ٥٠، ٥٠))
  لاکێش(دوژمن، ٢٧٥، ٢٠، ٢٥)
  ڕەنگبکە("سپی")
  بازنە(دوژمن + ٥، ٢٨٣، ٣)؛ بازنە(دوژمن + ١٥، ٢٨٣، ٣)
  ڕەنگبکە("ئاسمانی")
  لاکێش(x، y، ١٦، ٢٠)
  ڕەنگبکە("سپی")
  بازنە(x + ٥، y + ٦، ٣)؛ بازنە(x + ١١، y + ٦، ٣)
  ڕەنگبکە("ڕەش")
  نووسین("سکە: " + خاڵ + "/٨", ١٠، ٢٤، ٢٠)
  ئەگەر بردرا { ڕەنگبکە("ڕەش")؛ نووسین("🎉 بردتەوە! کلیک = دووبارە", ١٠٠، ١٦٠، ٢٨) }
})
