// 🌀 مەندەلبرۆت — فراکتاڵی ناوداری بیرکاری. هەر خاڵێک ئایا بەرەو بێکۆتایی دەڕوات یان نا؟ (چەند چرکەیەک چاوەڕێ بکە)
قەبارە(٣٦٠، ٢٤٠)
پاشبنەمابکە("ڕەش")
نەگۆڕ قەبارەی_خانە = ٤
بۆ px لە ٠ تا ٣٥٩ هەنگاو ٤ {
  بۆ py لە ٠ تا ٢٣٩ هەنگاو ٤ {
    نەگۆڕ cx = (px - ٢٣٠) / ١٢٠
    نەگۆڕ cy = (py - ١٢٠) / ١٢٠
    گۆڕاو zx = ٠
    گۆڕاو zy = ٠
    گۆڕاو دووبارە = ٠
    هەتا zx * zx + zy * zy < ٤ و دووبارە < ٤٠ {
      نەگۆڕ t = zx * zx - zy * zy + cx
      zy = ٢ * zx * zy + cy
      zx = t
      دووبارە += ١
    }
    ئەگەر دووبارە < ٤٠ {
      ڕەنگبکە(پەلکەزێڕینە(دووبارە * ١٠ + ٢٠٠))
      لاکێش(px، py، قەبارەی_خانە، قەبارەی_خانە)
    }
  }
}
