// 🎡 سپیرۆگرافی زیندوو — چەرخێک لە ناو چەرخێکدا دەسووڕێتەوە و شێوەی جوان دەکێشێت. ماوس بجووڵێنە بۆ گۆڕینی شێوە
قەبارە(٤٠٠، ٤٠٠)
گۆڕاو نوختەکان = []
گۆڕاو t = ٠
یاریبکە(() => {
  نەگۆڕ r = ماوسX() >= ٠ ? ٣٠ + ماوسX() / ٥ : ٦٠
  نەگۆڕ d = ماوسY() >= ٠ ? ٣٠ + ماوسY() / ٥ : ٨٠
  بۆ گ لە ١ تا ٤ {
    t += ٠٫٠٦
    نەگۆڕ R = ١٤٠
    نەگۆڕ x = ٢٠٠ + (R - r) * کۆسینۆس(t) + d * کۆسینۆس((R - r) / r * t)
    نەگۆڕ y = ٢٠٠ + (R - r) * سینۆس(t) - d * سینۆس((R - r) / r * t)
    نوختەکان.زیادبکە({ x: x، y: y، ڕ: t * ٢٠ })
  }
  نوختەکان = نوختەکان.ببڕە(-١٨٠٠)
  پاشبنەمابکە(ڕەنگی(١٠، ١٠، ٢٥))
  بۆ هەر ن لە نوختەکان {
    ڕەنگبکە(پەلکەزێڕینە(ن.ڕ))
    بازنە(ن.x، ن.y، ٢)
  }
})
