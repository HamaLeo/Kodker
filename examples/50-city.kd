// 🌃 شاری شەو — بینای بەرز، پەنجەرەی گەش و ئەستێرەی لەرزۆک. کلیک بکە بۆ گۆڕینی شار
قەبارە(٥٠٠، ٣٢٠)
گۆڕاو بیناکان = []
گۆڕاو ئەستێرەکان = []
گۆڕاو کات = ٠

کار شاری_نوێ() {
  بیناکان = []
  گۆڕاو x = ٠
  هەتا x < ٥٠٠ {
    نەگۆڕ پان = هەڕەمەکی(٣٠، ٧٠)
    نەگۆڕ بەرز = هەڕەمەکی(٦٠، ٢١٠)
    نەگۆڕ پەنجەرەکان = []
    بۆ ستوون لە ٠ تا خوارکە(پان / ١٢) - ٢ {
      بۆ ڕیز لە ٠ تا خوارکە(بەرز / ١٨) - ٢ { پەنجەرەکان.زیادبکە({ ک: ستوون، ڕ: ڕیز، لێ: هەڕەمەکی(٠، ٢) > ٠، فاز: هەڕەمەکی(٠، ٦٠٠) }) }
    }
    بیناکان.زیادبکە({ x: x، پان: پان، بەرز: بەرز، ڕەنگ: هەڕەمەکی(٢٠، ٤٥)، پەنجەرەکان: پەنجەرەکان })
    x += پان + هەڕەمەکی(٢، ٨)
  }
  ئەستێرەکان = []
  بۆ i لە ١ تا ٧٠ { ئەستێرەکان.زیادبکە({ x: هەڕەمەکی(٠، ٥٠٠)، y: هەڕەمەکی(٠، ١٣٠)، ف: هەڕەمەکی(٠، ٣٠٠) }) }
}
شاری_نوێ()

یاریبکە(() => {
  کات += ١
  ئەگەر کلیککراوە() { شاری_نوێ() }
  بۆ i لە ٠ تا ٣١ {
    ڕەنگبکە(ڕەنگی(١٠ + i، ١٥ + i، ٣٥ + i * ٣))
    لاکێش(٠، i * ١٠، ٥٠٠، ١١)
  }
  بۆ هەر ئ لە ئەستێرەکان {
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٤ + ٠٫٤ * سینۆس((کات + ئ.ف) / ١٥)))
    بازنە(ئ.x، ئ.y، ١٫٥)
  }
  ڕەنگبکە(ڕەنگی(٢٤٠، ٢٣٠، ٢٠٠))
  بازنە(٤٢٠، ٦٠، ٢٢)
  ڕەنگبکە(ڕەنگی(١٥، ٢٠، ٤٥))
  بازنە(٤٢٩، ٥٣، ٢٠)
  بۆ هەر ب لە بیناکان {
    ڕەنگبکە(ڕەنگی(ب.ڕەنگ، ب.ڕەنگ + ٥، ب.ڕەنگ + ٢٠))
    لاکێش(ب.x، ٣٢٠ - ب.بەرز، ب.پان، ب.بەرز)
    بۆ هەر پ لە ب.پەنجەرەکان {
      ڕەنگبکە(پ.لێ ? ڕەنگی(٢٥٥، ٢٢٠ + (پ.ک * ٧) % ٣٠، ١٢٠، ٠٫٩) : ڕەنگی(٣٠، ٣٥، ٦٠))
      لاکێش(ب.x + ٦ + پ.ک * ١٢، ٣٢٠ - ب.بەرز + ٨ + پ.ڕ * ١٨، ٧، ١٠)
    }
  }
})
