// یاری: خۆرەکێش 🟡 — هەموو خاڵەکان بخۆ و لە ڕۆحە سوور و پەمەییەکان ڕابکە. بە تیرەکان بەرەو ئاڕاستە بگۆڕە
قەبارە(٤٥٠، ٣٦٠)
نەگۆڕ نەخشە = [
  "###############",
  "#.............#",
  "#.###.###.###.#",
  "#.............#",
  "#.###.#.#.###.#",
  "#.....#.#.....#",
  "###.#.#.#.#.###",
  "#...#.....#...#",
  "#.###.###.###.#",
  "#.............#",
  "###############",
]
گۆڕاو خاڵەکان = {}
گۆڕاو کۆی = ٠
گۆڕاو px = ١
گۆڕاو py = ١
گۆڕاو ئاڕاستە = { x: ٠، y: ٠ }
گۆڕاو داواکراو = { x: ٠، y: ٠ }
گۆڕاو ڕۆحەکان = []
گۆڕاو خاڵ = ٠
گۆڕاو ژیان = ٣
گۆڕاو کات = ٠
گۆڕاو بردرا = هەڵە

کار دەستپێکردن(تەواو) {
  px = ١؛ py = ١؛ ئاڕاستە = { x: ٠، y: ٠ }؛ داواکراو = { x: ٠، y: ٠ }
  ڕۆحەکان = [{ x: ١٣، y: ٩، ئا: { x: -١، y: ٠ }، ڕەنگ: "سوور" }، { x: ١٣، y: ١، ئا: { x: -١، y: ٠ }، ڕەنگ: "پەمەیی" }]
  ئەگەر تەواو {
    خاڵەکان = {}؛ کۆی = ٠؛ خاڵ = ٠؛ ژیان = ٣؛ بردرا = هەڵە
    بۆ y لە ٠ تا ١٠ { بۆ x لە ٠ تا ١٤ { ئەگەر نەخشە[y][x] == "." و نەک (x == ١ و y == ١) { خاڵەکان[x + "," + y] = ڕاست؛ کۆی += ١ } } }
  }
}
دەستپێکردن(ڕاست)

کار دیوارە(x، y) { گەڕێنەوە نەخشە[y][x] == "#" }

یاریبکە(() => {
  کات += ١
  ئەگەر کلیل("چەپ") { داواکراو = { x: -١، y: ٠ } }
  ئەگەر کلیل("ڕاست") { داواکراو = { x: ١، y: ٠ } }
  ئەگەر کلیل("سەرەوە") { داواکراو = { x: ٠، y: -١ } }
  ئەگەر کلیل("خوارەوە") { داواکراو = { x: ٠، y: ١ } }

  ئەگەر ژیان > ٠ و نەک بردرا {
    ئەگەر کات % ٧ == ٠ {
      ئەگەر نەک دیوارە(px + داواکراو.x، py + داواکراو.y) { ئاڕاستە = داواکراو }
      ئەگەر نەک دیوارە(px + ئاڕاستە.x، py + ئاڕاستە.y) { px += ئاڕاستە.x؛ py += ئاڕاستە.y }
      ئەگەر خاڵەکان[px + "," + py] { خاڵەکان[px + "," + py] = هەڵە؛ خاڵ += ١٠؛ کۆی -= ١ }
      ئەگەر کۆی == ٠ { بردرا = ڕاست }
    }
    ئەگەر کات % ١٠ == ٠ {
      بۆ هەر ڕ لە ڕۆحەکان {
        نەگۆڕ ئاڕاستەکان = [{ x: ١، y: ٠ }، { x: -١، y: ٠ }، { x: ٠، y: ١ }، { x: ٠، y: -١ }]
        نەگۆڕ دروستەکان = ئاڕاستەکان.پاڵاوتن(د => نەک دیوارە(ڕ.x + د.x، ڕ.y + د.y) و نەک (د.x == -ڕ.ئا.x و د.y == -ڕ.ئا.y))
        نەگۆڕ هەڵبژێردراو = دروستەکان.درێژی > ٠ ? دروستەکان : ئاڕاستەکان.پاڵاوتن(د => نەک دیوارە(ڕ.x + د.x، ڕ.y + د.y))
        // ٦٠٪ نزیکتر لە خۆرەکێش
        گۆڕاو باشترین = هەڵبژێردراو[هەڕەمەکی(٠، هەڵبژێردراو.درێژی - ١)]
        ئەگەر هەڕەمەکی(١، ١٠) <= ٦ {
          بۆ هەر د لە هەڵبژێردراو {
            ئەگەر دووری(ڕ.x + د.x، ڕ.y + د.y، px، py) < دووری(ڕ.x + باشترین.x، ڕ.y + باشترین.y، px، py) { باشترین = د }
          }
        }
        ڕ.ئا = باشترین؛ ڕ.x += باشترین.x؛ ڕ.y += باشترین.y
      }
    }
    بۆ هەر ڕ لە ڕۆحەکان { ئەگەر ڕ.x == px و ڕ.y == py { ژیان -= ١؛ دەستپێکردن(هەڵە) } }
  } ئەگەرنا ئەگەر کلیککراوە() { دەستپێکردن(ڕاست) }

  پاشبنەمابکە(ڕەنگی(٥، ٥، ٢٠))
  بۆ y لە ٠ تا ١٠ {
    بۆ x لە ٠ تا ١٤ {
      ئەگەر نەخشە[y][x] == "#" { ڕەنگبکە(ڕەنگی(٣٠، ٥٠، ١٨٠))؛ لاکێش(x * ٣٠ + ١، y * ٣٠ + ٣١، ٢٨، ٢٨) }
      ئەگەر خاڵەکان[x + "," + y] { ڕەنگبکە(ڕەنگی(٢٥٥، ٢٢٠، ١٨٠))؛ بازنە(x * ٣٠ + ١٥، y * ٣٠ + ٤٥، ٣) }
    }
  }
  ڕەنگبکە("زەرد")
  بازنە(px * ٣٠ + ١٥، py * ٣٠ + ٤٥، ١٢)
  ڕەنگبکە("ڕەش")
  سێگۆشە(px * ٣٠ + ١٥، py * ٣٠ + ٤٥، px * ٣٠ + ١٥ + ئاڕاستە.x * ١٤ + ئاڕاستە.y * ٨، py * ٣٠ + ٤٥ + ئاڕاستە.y * ١٤ - ئاڕاستە.x * ٨، px * ٣٠ + ١٥ + ئاڕاستە.x * ١٤ - ئاڕاستە.y * ٨، py * ٣٠ + ٤٥ + ئاڕاستە.y * ١٤ + ئاڕاستە.x * ٨)
  بۆ هەر ڕ لە ڕۆحەکان {
    ڕەنگبکە(ڕ.ڕەنگ)
    بازنە(ڕ.x * ٣٠ + ١٥، ڕ.y * ٣٠ + ٤٣، ١٢)
    لاکێش(ڕ.x * ٣٠ + ٣، ڕ.y * ٣٠ + ٤٣، ٢٤، ١٣)
    ڕەنگبکە("سپی")
    بازنە(ڕ.x * ٣٠ + ١٠، ڕ.y * ٣٠ + ٤٠، ٣)؛ بازنە(ڕ.x * ٣٠ + ٢٠، ڕ.y * ٣٠ + ٤٠، ٣)
  }
  ڕەنگبکە("سپی")
  نووسین("خاڵ: " + خاڵ، ١٠، ٢٢، ٢٠)
  نووسین("❤ " + گەورەترین(ژیان، ٠)، ٣٨٠، ٢٢، ٢٠)
  ئەگەر بردرا { نووسین("🎉 بردتەوە! کلیک = دووبارە", ٨٠، ١٨٠، ٢٨) }
  ئەگەر ژیان <= ٠ { نووسین("تەواو بوو! کلیک = دووبارە", ٩٠، ١٨٠، ٢٦) }
})
