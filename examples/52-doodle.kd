// یاری: باز بدە ⬆ — بە خۆی باز دەدات! بە ← → یان ماوس بیجووڵێنە و بەرەو سەرەوە بڕۆ. نەکەویتە خوارەوە
قەبارە(٣٢٠، ٤٨٠)
گۆڕاو x = ١٤٠
گۆڕاو y = ٣٠٠
گۆڕاو vy = -١٢
گۆڕاو پلەکان = []
گۆڕاو بەرزی = ٠
گۆڕاو مردووە = هەڵە
گۆڕاو بەرزترین = ٠

کار دەستپێکردن() {
  x = ١٤٠؛ y = ٣٠٠؛ vy = -١٢؛ بەرزی = ٠؛ مردووە = هەڵە
  پلەکان = [{ x: ١٢٠، y: ٣٨٠، جۆر: ٠ }]
  بۆ i لە ١ تا ٨ { پلەکان.زیادبکە({ x: هەڕەمەکی(٠، ٢٥٠)، y: ٣٨٠ - i * ٦٠، جۆر: هەڕەمەکی(٠، ٤) == ٠ ? ١ : ٠ }) }
}
دەستپێکردن()

یاریبکە(() => {
  ئەگەر نەک مردووە {
    ئەگەر کلیل("چەپ") { x -= ٦ }
    ئەگەر کلیل("ڕاست") { x += ٦ }
    ئەگەر ماوسX() >= ٠ { x += (ماوسX() - ٢٠ - x) * ٠٫١ }
    x = ((x + ٢٠) % ٣٢٠ + ٣٢٠) % ٣٢٠ - ٢٠
    نەگۆڕ پێشوو = y + ٤٠
    vy += ٠٫٦
    y += vy
    ئەگەر vy > ٠ {
      بۆ هەر پ لە پلەکان {
        ئەگەر پێشوو <= پ.y + ٣ و y + ٤٠ >= پ.y و x + ٣٠ > پ.x و x + ١٠ < پ.x + ٧٠ { vy = پ.جۆر == ١ ? -١٧ : -١٢ }
      }
    }
    // کامێرا
    ئەگەر y < ٢٠٠ {
      نەگۆڕ جیاوازی = ٢٠٠ - y
      y = ٢٠٠
      بەرزی += جیاوازی
      بۆ هەر پ لە پلەکان { پ.y += جیاوازی }
    }
    پلەکان = پلەکان.پاڵاوتن(پ => پ.y < ٤٩٠)
    هەتا پلەکان.درێژی < ٩ {
      گۆڕاو بەرزترینپلە = ٥٠٠
      بۆ هەر پ لە پلەکان { بەرزترینپلە = بچووکترین(بەرزترینپلە، پ.y) }
      پلەکان.زیادبکە({ x: هەڕەمەکی(٠، ٢٥٠)، y: بەرزترینپلە - هەڕەمەکی(٥٠، ٨٠)، جۆر: هەڕەمەکی(٠، ٥) == ٠ ? ١ : ٠ })
    }
    ئەگەر y > ٥٠٠ { مردووە = ڕاست }
    بەرزترین = گەورەترین(بەرزترین، خوارکە(بەرزی))
  } ئەگەرنا ئەگەر کلیککراوە() { دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(٢٣٠، ٢٤٥، ٢٥٥))
  ڕەنگبکە(ڕەنگی(٢٠٠، ٢٢٠، ٢٤٠))
  بۆ i لە ٠ تا ١٥ { لاکێش(٠، i * ٣٠، ٣٢٠، ١) }
  بۆ هەر پ لە پلەکان {
    ڕەنگبکە(پ.جۆر == ١ ? "نارنجی" : "سەوز")
    لاکێش(پ.x، پ.y، ٧٠، ١٢)
    ئەگەر پ.جۆر == ١ { ڕەنگبکە("سپی")؛ لاکێش(پ.x + ٢٠، پ.y + ٣، ٣٠، ٣) }
  }
  ڕەنگبکە("زەرد")
  لاکێش(x + ١٠، y، ٣٠، ٣٨)
  ڕەنگبکە("سپی")
  بازنە(x + ٢٠، y + ١٠، ٦)؛ بازنە(x + ٣٢، y + ١٠، ٦)
  ڕەنگبکە("ڕەش")
  بازنە(x + ٢٢، y + ١٠، ٢)؛ بازنە(x + ٣٤، y + ١٠، ٢)
  ڕەنگبکە("ڕەش")
  نووسین("بەرزی: " + خوارکە(بەرزی)، ١٠، ٢٨، ٢٠)
  نووسین("باشترین: " + بەرزترین، ٢٠٠، ٢٨، ١٦)
  ئەگەر مردووە {
    ڕەنگبکە(ڕەنگی(٠، ٠، ٠، ٠٫٦))
    لاکێش(٠، ٠، ٣٢٠، ٤٨٠)
    ڕەنگبکە("سپی")
    نووسین("کەوتیت! کلیک = دووبارە", ٥٥، ٢٣٠، ٢٦)
  }
})
