// یاری: چوار بە دووی یەک 🔴🟡 — کلیک لە ستوونێک بکە، چوار بەردی هاوڕەنگ لە ڕیزێکدا (ئاسۆیی، ستوونی، لار) ببە
قەبارە(٣٥٠، ٤٢٠)
گۆڕاو تەخت = []
گۆڕاو کێ = ١          // ١ تۆ، ٢ کۆمپیوتەر
گۆڕاو براوە = ٠       // ٠ بەردەوام، ١/٢ براوە، ٣ یەکسان
گۆڕاو چاوەڕێ = ٠

کار دەستپێکردن() {
  تەخت = []
  بۆ i لە ١ تا ٤٢ { تەخت.زیادبکە(٠) }
  کێ = ١؛ براوە = ٠
}
دەستپێکردن()

کار خانە(ڕ، ک) { گەڕێنەوە ڕ >= ٠ و ڕ < ٦ و ک >= ٠ و ک < ٧ ? تەخت[ڕ * ٧ + ک] : -١ }

کار ڕیزی_چوار(کەس) {
  بۆ ڕ لە ٠ تا ٥ {
    بۆ ک لە ٠ تا ٦ {
      بۆ هەر د لە [[٠، ١]، [١، ٠]، [١، ١]، [١، -١]] {
        گۆڕاو ژمارە = ٠
        بۆ i لە ٠ تا ٣ { ئەگەر خانە(ڕ + د[٠] * i، ک + د[١] * i) == کەس { ژمارە += ١ } }
        ئەگەر ژمارە == ٤ { گەڕێنەوە ڕاست }
      }
    }
  }
  گەڕێنەوە هەڵە
}

کار بیخە(ک، کەس) {
  بۆ ڕ لە ٥ تا ٠ هەنگاو -١ {
    ئەگەر تەخت[ڕ * ٧ + ک] == ٠ { تەخت[ڕ * ٧ + ک] = کەس؛ گەڕێنەوە ڕاست }
  }
  گەڕێنەوە هەڵە
}

کار کاتی_کۆمپیوتەر() {
  // ١. ببە ٢. دژەکەت بوەستێنە ٣. ناوەندی نزیک
  بۆ هەر کەس لە [٢، ١] {
    بۆ ک لە ٠ تا ٦ {
      ئەگەر تەخت[ک] == ٠ {
        بیخە(ک، کەس)
        نەگۆڕ ب = ڕیزی_چوار(کەس)
        بۆ ڕ لە ٠ تا ٥ { ئەگەر تەخت[ڕ * ٧ + ک] == کەس { تەخت[ڕ * ٧ + ک] = ٠؛ ڕ = ٧ } }
        ئەگەر ب { گەڕێنەوە ک }
      }
    }
  }
  نەگۆڕ ڕیزبەندی = [٣، ٢، ٤، ١، ٥، ٠، ٦]
  بۆ هەر ک لە ڕیزبەندی { ئەگەر تەخت[ک] == ٠ { گەڕێنەوە ک } }
  گەڕێنەوە -١
}

یاریبکە(() => {
  ئەگەر براوە == ٠ {
    ئەگەر کێ == ١ {
      ئەگەر کلیککراوە() {
        نەگۆڕ ک = خوارکە(ماوسX() / ٥٠)
        ئەگەر ک >= ٠ و ک < ٧ و بیخە(ک، ١) {
          ئەگەر ڕیزی_چوار(١) { براوە = ١ } ئەگەرنا ئەگەر نەک تەخت.لەخۆدەگرێت(٠) { براوە = ٣ } ئەگەرنا { کێ = ٢؛ چاوەڕێ = ٣٠ }
        }
      }
    } ئەگەرنا {
      چاوەڕێ -= ١
      ئەگەر چاوەڕێ <= ٠ {
        نەگۆڕ ک = کاتی_کۆمپیوتەر()
        ئەگەر ک >= ٠ { بیخە(ک، ٢) }
        ئەگەر ڕیزی_چوار(٢) { براوە = ٢ } ئەگەرنا ئەگەر نەک تەخت.لەخۆدەگرێت(٠) { براوە = ٣ } ئەگەرنا { کێ = ١ }
      }
    }
  } ئەگەرنا ئەگەر کلیککراوە() { دەستپێکردن() }

  پاشبنەمابکە(ڕەنگی(١٥، ٢٠، ٤٥))
  ڕەنگبکە(ڕەنگی(٣٠، ٦٠، ١٨٠))
  لاکێش(٠، ٥٠، ٣٥٠، ٣٠٠)
  بۆ ڕ لە ٠ تا ٥ {
    بۆ ک لە ٠ تا ٦ {
      نەگۆڕ v = تەخت[ڕ * ٧ + ک]
      ڕەنگبکە(v == ١ ? "سوور" : v == ٢ ? "زەرد" : ڕەنگی(١٥، ٢٠، ٤٥))
      بازنە(ک * ٥٠ + ٢٥، ڕ * ٥٠ + ٧٥، ٢٠)
    }
  }
  ڕەنگبکە("سپی")
  گۆڕاو پەیام = کێ == ١ ? "نۆرەی تۆیە: ستوونێک هەڵبژێرە" : "کۆمپیوتەر بیر دەکاتەوە..."
  ئەگەر براوە == ١ { پەیام = "بردتەوە! 🎉 (کلیک = دووبارە)" }
  ئەگەر براوە == ٢ { پەیام = "کۆمپیوتەر بردیەوە (کلیک = دووبارە)" }
  ئەگەر براوە == ٣ { پەیام = "یەکسان بوون (کلیک = دووبارە)" }
  نووسین(پەیام، ٢٠، ٣٥، ٢٠)
  ئەگەر ماوسY() >= ٠ و براوە == ٠ و کێ == ١ {
    ڕەنگبکە(ڕەنگی(٢٥٥، ٢٥٥، ٢٥٥، ٠٫٢))
    لاکێش(خوارکە(ماوسX() / ٥٠) * ٥٠، ٥٠، ٥٠، ٣٠٠)
  }
})
