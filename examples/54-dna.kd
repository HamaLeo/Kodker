// 🧬 DNA — دوو ڕیسی زیندوو کە بە یەکەوە دەسووڕێن، و پردەکانیان
قەبارە(٣٦٠، ٤٠٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠٦
  پاشبنەمابکە(ڕەنگی(٨، ١٠، ٢٨))
  بۆ i لە ٠ تا ٣٩ {
    نەگۆڕ y = ٢٠ + i * ٩٫٦
    نەگۆڕ دوری = سینۆس(i * ٠٫٣٥ + کات)
    نەگۆڕ x١ = ١٨٠ + دوری * ٨٠
    نەگۆڕ x٢ = ١٨٠ - دوری * ٨٠
    نەگۆڕ بەرەو = کۆسینۆس(i * ٠٫٣٥ + کات)
    هێڵڕەنگبکە(ڕەنگی(١٢٠، ١٣٠، ١٨٠، ٠٫٦))
    ئەستووریبکە(٢)
    هێڵ(x١، y، x٢، y)
    ڕەنگبکە(پەلکەزێڕینە(i * ٩))
    بازنە(x١، y، ٦ + بەرەو * ٢)
    ڕەنگبکە(پەلکەزێڕینە(i * ٩ + ١٨٠))
    بازنە(x٢، y، ٦ - بەرەو * ٢)
  }
})
