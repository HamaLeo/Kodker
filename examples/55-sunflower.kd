// 🌻 گوڵی خۆرەتاو — ٥٠٠ تۆ بە «گۆشەی زێڕین» (١٣٧٫٥°) ڕێک دەخرێن، هەمان شێوازی سروشت. ماوس بجووڵێنە بۆ گۆڕینی گۆشە
قەبارە(٤٠٠، ٤٠٠)
گۆڕاو کات = ٠
یاریبکە(() => {
  کات += ٠٫٠١
  نەگۆڕ گۆشە = ماوسX() >= ٠ ? ١٣٠ + ماوسX() / ٥٠ : ١٣٧٫٥
  پاشبنەمابکە(ڕەنگی(٣٠، ٦٠، ٣٠))
  بۆ i لە ١ تا ٥٠٠ {
    نەگۆڕ ڕ = ٨ * ڕەگ(i)
    نەگۆڕ g = (i * گۆشە + کات * ٢٠) * پای / ١٨٠
    ڕەنگبکە(ڕەنگی(٢٢٠ - i * ٠٫٠٨، ١٥٠ - i * ٠٫٠٥، ٢٠ + i * ٠٫٠٣))
    بازنە(٢٠٠ + کۆسینۆس(g) * ڕ، ٢٠٠ + سینۆس(g) * ڕ، ٣ + ڕ / ٤٠)
  }
})
