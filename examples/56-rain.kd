// 🌧 باران — دڵۆپە و بازنەی ئاو لەسەر زەوی. کلیک بکە بۆ ڕەعدی ڕووناک
قەبارە(٥٠٠، ٣٢٠)
گۆڕاو دڵۆپەکان = []
گۆڕاو بازنەکان = []
گۆڕاو ڕووناکی = ٠
یاریبکە(() => {
  ئەگەر کلیککراوە() { ڕووناکی = ٣٠ }
  ڕووناکی = گەورەترین(٠، ڕووناکی - ١)
  بۆ i لە ١ تا ٤ { دڵۆپەکان.زیادبکە({ x: هەڕەمەکی(٠، ٥٢٠)، y: -١٠، خ: هەڕەمەکی(٨، ١٣)، زەوی: هەڕەمەکی(٢٣٠، ٣٠٠) }) }
  پاشبنەمابکە(ڕەنگی(١٥ + ڕووناکی * ٧، ٢٠ + ڕووناکی * ٧، ٣٥ + ڕووناکی * ٧))
  ڕەنگبکە(ڕەنگی(٢٠، ٣٠، ٤٥))
  لاکێش(٠، ٢٣٠، ٥٠٠، ٩٠)
  هێڵڕەنگبکە(ڕەنگی(١٨٠، ٢٠٠، ٢٥٥، ٠٫٦))
  ئەستووریبکە(١)
  بۆ هەر د لە دڵۆپەکان {
    د.y += د.خ
    هێڵ(د.x، د.y، د.x - ١، د.y - ٨)
    ئەگەر د.y >= د.زەوی { بازنەکان.زیادبکە({ x: د.x، y: د.زەوی، r: ١ }) }
  }
  دڵۆپەکان = دڵۆپەکان.پاڵاوتن(د => د.y < د.زەوی)
  بۆ هەر ب لە بازنەکان {
    ب.r += ٠٫٦
    هێڵڕەنگبکە(ڕەنگی(١٨٠، ٢٠٠، ٢٥٥، ١ - ب.r / ١٢))
    بازنەهێڵ(ب.x، ب.y، ب.r)
  }
  بازنەکان = بازنەکان.پاڵاوتن(ب => ب.r < ١٢)
})
